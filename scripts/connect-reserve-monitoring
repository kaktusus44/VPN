#!/usr/bin/env bash
set -Eeuo pipefail

MAIN_IP="${1:-${VPN_MAIN_IP:-}}"
RESERVE_IP="${2:-${VPN_RESERVE_IP:-}}"
INVENTORY_PATH=""

ask_tty() {
  local prompt="$1"
  local answer
  if [ ! -r /dev/tty ]; then
    return 1
  fi
  read -r -p "$prompt" answer </dev/tty
  printf '%s' "$answer"
}

validate_ipv4() {
  local value="$1"
  if ! [[ "$value" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    echo "Ожидался IPv4-адрес, получено: $value" >&2
    exit 1
  fi
}

add_known_host() {
  local ip="$1"
  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
  if ! ssh-keygen -F "$ip" >/dev/null 2>&1; then
    echo "Добавляю SSH host key для $ip"
    ssh-keyscan -T 5 -H "$ip" >> "$HOME/.ssh/known_hosts"
  fi
}

write_inventory() {
  mkdir -p "$(dirname "$INVENTORY_PATH")"
  cat > "$INVENTORY_PATH" <<EOF
---
all:
  children:
    vpn_servers:
      hosts:
        vpn-main:
          ansible_host: $MAIN_IP
          ansible_user: root
          ansible_port: 22
          vpn_server_role: main
          vpn_public_endpoint: $MAIN_IP
        vpn-reserve:
          ansible_host: $RESERVE_IP
          ansible_user: root
          ansible_port: 22
          vpn_server_role: reserve
          vpn_public_endpoint: $RESERVE_IP
EOF
}

if [ -z "$MAIN_IP" ]; then
  MAIN_IP="$(ask_tty "IP main сервера: " || true)"
fi

if [ -z "$RESERVE_IP" ]; then
  RESERVE_IP="$(ask_tty "IP reserve сервера: " || true)"
fi

if [ -z "$MAIN_IP" ] || [ -z "$RESERVE_IP" ]; then
  echo "Нужны оба IP: main и reserve." >&2
  echo "Использование: scripts/connect-reserve-monitoring <main-ip> <reserve-ip>" >&2
  exit 1
fi

validate_ipv4 "$MAIN_IP"
validate_ipv4 "$RESERVE_IP"

if [ "$MAIN_IP" = "$RESERVE_IP" ]; then
  echo "Main IP и reserve IP должны отличаться." >&2
  exit 1
fi

cd "$(dirname "$0")/.."

INVENTORY_PATH="$PWD/inventories/managed/hosts.yml"
ANSIBLE_BIN="$PWD/.venv/bin/ansible"
ANSIBLE_PLAYBOOK_BIN="$PWD/.venv/bin/ansible-playbook"

if [ ! -x "$ANSIBLE_BIN" ] || [ ! -x "$ANSIBLE_PLAYBOOK_BIN" ]; then
  echo "Совместимая версия Ansible не установлена." >&2
  echo "Сначала запустите: VPN_DIR=\"$PWD\" bash scripts/bootstrap-ubuntu-control" >&2
  exit 1
fi

write_inventory
add_known_host "$MAIN_IP"
add_known_host "$RESERVE_IP"

cat <<EOF
===== CONNECT RESERVE MONITORING =====
Серверы:
  main: $MAIN_IP
  reserve: $RESERVE_IP
  inventory: $INVENTORY_PATH

Что произойдёт:
  1. SSH/Ansible ping обеих нод
  2. установка/обновление monitoring exporters на reserve
  3. перерендер /etc/prometheus/prometheus.yml на main
  4. restart Prometheus на main, только если config изменился

Что не трогаем:
  VPN core
  AmneziaWG/Xray config
  клиентские ключи и /var/lib/vpn
===== КОНЕЦ ВВОДНЫХ =====
EOF

echo
echo "==> [1/2] Проверка SSH/Ansible"
"$ANSIBLE_BIN" --version | head -n 1
"$ANSIBLE_BIN" -i "$INVENTORY_PATH" all -m ping

echo
echo "==> [2/2] Подключение reserve к monitoring"
"$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY_PATH" playbooks/connect-reserve-monitoring.yml

cat <<EOF

===== ИТОГ =====
Reserve monitoring подключён.
Prometheus targets на main обновлены без redeploy VPN core.

Проверить targets:
  ssh -i ~/.ssh/vpn_ansible root@$MAIN_IP 'curl -s http://127.0.0.1:9090/api/v1/targets | jq ".data.activeTargets[] | {job: .labels.job, server: .labels.server, role: .labels.role, health: .health}"'
===== КОНЕЦ ИТОГА =====
EOF
