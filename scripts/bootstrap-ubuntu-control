#!/usr/bin/env bash
set -Eeuo pipefail

REPO_URL="${VPN_REPO_URL:-https://github.com/kaktusus44/VPN.git}"
INSTALL_DIR="${VPN_DIR:-$HOME/VPN}"
SSH_KEY_PATH="${VPN_SSH_KEY:-$HOME/.ssh/vpn_ansible}"
ANSIBLE_VENV="$INSTALL_DIR/.venv"
ANSIBLE_CORE_SPEC="ansible-core>=2.17,<2.18"
APT_PACKAGES_INSTALLED=()

log() {
  printf '\n==> [%s] %s\n' "$(date +%H:%M:%S)" "$*"
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1
}

if need_cmd sudo; then
  SUDO=sudo
else
  SUDO=
fi

wait_for_apt() {
  local waited=0
  while need_cmd fuser && $SUDO fuser /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/cache/apt/archives/lock >/dev/null 2>&1; do
    if [ "$waited" -eq 0 ]; then
      log "Жду, пока Ubuntu закончит фоновое обновление apt"
    fi
    echo "apt занят другим процессом, жду 10 секунд..."
    sleep 10
    waited=$((waited + 10))
  done
}

ask_tty() {
  local prompt="$1"
  local answer
  if [ ! -r /dev/tty ]; then
    return 1
  fi
  read -r -p "$prompt" answer </dev/tty
  printf '%s' "$answer"
}

collection_installed() {
  local collection_pattern="${1//./\\.}"
  "$ANSIBLE_VENV/bin/ansible-galaxy" collection list 2>/dev/null | grep -Eq "^${collection_pattern}[[:space:]]"
}

install_collections() {
  local attempt

  if collection_installed ansible.posix && collection_installed community.general; then
    echo "Нужные Ansible collections уже установлены."
    return 0
  fi

  for attempt in 1 2 3; do
    echo "Попытка $attempt/3 скачать Ansible collections..."
    if "$ANSIBLE_VENV/bin/ansible-galaxy" collection install -r requirements.yml; then
      return 0
    fi
    if [ "$attempt" -lt 3 ]; then
      echo "Galaxy не ответил, повторяю через 10 секунд..."
      sleep 10
    fi
  done

  echo
  echo "ВНИМАНИЕ: Galaxy сейчас недоступен, collections не установлены."
  echo "Проверку сервера продолжаю: preflight использует встроенные модули."
  echo "Перед запуском playbooks/vpn-core.yml повторите:"
  echo "  cd \"$INSTALL_DIR\" && .venv/bin/ansible-galaxy collection install -r requirements.yml"
}

ansible_core_compatible() {
  [ -x "$ANSIBLE_VENV/bin/python" ] && \
    "$ANSIBLE_VENV/bin/python" -c \
      'import ansible, sys; sys.exit(0 if ansible.__version__.startswith("2.17.") else 1)' \
      >/dev/null 2>&1
}

print_control_summary() {
  local installed_packages

  if [ "${#APT_PACKAGES_INSTALLED[@]}" -gt 0 ]; then
    installed_packages="${APT_PACKAGES_INSTALLED[*]}"
  else
    installed_packages="ничего, все нужные apt-пакеты уже были на месте"
  fi

  cat <<EOF

===== ИТОГ ПОДГОТОВКИ УПРАВЛЯЮЩЕЙ UBUNTU =====
Репозиторий:
  $INSTALL_DIR

SSH-ключи Ansible:
  приватный: $SSH_KEY_PATH
  публичный: $SSH_KEY_PATH.pub
  права: приватный 600, публичный 644

Что проверено/установлено локально:
  apt-пакеты этого запуска: $installed_packages
  Ansible venv: $ANSIBLE_VENV
  Ansible binary: $ANSIBLE_VENV/bin/ansible
  Ansible playbook binary: $ANSIBLE_VENV/bin/ansible-playbook
  Ansible core: $ANSIBLE_CORE_SPEC
  Ansible collections: requirements.yml

Куда должен попасть публичный ключ на VPS:
  /root/.ssh/authorized_keys

Ручной повторный запуск развёртывания:
  cd "$INSTALL_DIR"
  VPN_CLIENT_COUNT=100 scripts/deploy-server main 1.2.3.4

Замените 1.2.3.4 на IP сервера.
Роль укажите main или reserve.
VPN_CLIENT_COUNT можно заменить на нужное количество Amnezia клиентов: 1-253.

При интерактивном первом запуске bootstrap ниже сам спросит роль/IP и вызовет
scripts/deploy-server после того, как публичный SSH-ключ будет добавлен на VPS.
===== КОНЕЦ ИТОГА =====
EOF

  echo
  "$ANSIBLE_VENV/bin/ansible" --version | head -n 1
  echo
  echo "Установленные Ansible collections:"
  "$ANSIBLE_VENV/bin/ansible-galaxy" collection list 2>/dev/null | grep -E '^(ansible\.posix|community\.general)[[:space:]]' || \
    echo "  ansible-galaxy collection list недоступен или collections ещё не установлены"
}

if ! need_cmd apt-get; then
  echo "Этот bootstrap-скрипт поддерживает Ubuntu/Debian с apt-get." >&2
  exit 1
fi

if [ -n "$SUDO" ]; then
  log "[1/6] Проверяю sudo-доступ"
  $SUDO -v
fi

MISSING_PACKAGES=()
need_cmd git || MISSING_PACKAGES+=(git)
need_cmd ssh || MISSING_PACKAGES+=(openssh-client)
need_cmd python3 || MISSING_PACKAGES+=(python3)
if ! dpkg-query -W -f='${Status}' python3-venv 2>/dev/null | grep -q 'ok installed'; then
  MISSING_PACKAGES+=(python3-venv)
fi

log "[2/6] Проверяю программы на управляющей Ubuntu"
if [ "${#MISSING_PACKAGES[@]}" -gt 0 ]; then
  echo "Нужно установить: ${MISSING_PACKAGES[*]}"
  APT_PACKAGES_INSTALLED=("${MISSING_PACKAGES[@]}")
  wait_for_apt
  $SUDO apt-get -o DPkg::Lock::Timeout=600 update || \
    echo "apt update завершился с предупреждением. Продолжаю по доступным индексам."
  wait_for_apt
  $SUDO DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=600 install -y "${MISSING_PACKAGES[@]}"
else
  echo "Все нужные программы уже установлены, apt пропускаю."
fi

log "[3/6] Готовлю SSH-ключ для Ansible"
mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

if [ -f "$SSH_KEY_PATH" ]; then
  echo "Использую существующий ключ: $SSH_KEY_PATH"
else
  ssh-keygen -q -t ed25519 -N "" -f "$SSH_KEY_PATH" -C "vpn-ansible-$(hostname)-$(date +%Y%m%d)"
fi
chmod 600 "$SSH_KEY_PATH"
chmod 644 "$SSH_KEY_PATH.pub"
PUBLIC_KEY_B64="$(base64 -w0 "$SSH_KEY_PATH.pub")"

echo
echo "===== СКОПИРУЙТЕ ЭТОТ ПУБЛИЧНЫЙ SSH-КЛЮЧ ====="
cat "$SSH_KEY_PATH.pub"
echo "===== КОНЕЦ SSH-КЛЮЧА ====="
echo
echo "Если VPS уже создан без ключа, выполните следующую команду"
echo "в консоли VPS под root:"
echo
cat <<EOF
KEY="\$(printf '%s' '$PUBLIC_KEY_B64' | base64 -d)"; install -d -m 700 /root/.ssh && touch /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys && { grep -qxF "\$KEY" /root/.ssh/authorized_keys || printf '%s\n' "\$KEY" >> /root/.ssh/authorized_keys; } && chown -R root:root /root/.ssh
EOF
echo

if [ -d "$INSTALL_DIR/.git" ]; then
  log "[4/6] Обновляю существующий репозиторий: $INSTALL_DIR"
  git -C "$INSTALL_DIR" pull --ff-only
elif [ -e "$INSTALL_DIR" ]; then
  echo "$INSTALL_DIR уже существует, но это не git-репозиторий." >&2
  echo "Переместите эту папку или запустите с VPN_DIR=/another/path." >&2
  exit 1
else
  log "[4/6] Скачиваю VPN-репозиторий"
  git clone "$REPO_URL" "$INSTALL_DIR"
fi

cd "$INSTALL_DIR"

log "[5/6] Устанавливаю совместимую версию Ansible"
if [ ! -x "$ANSIBLE_VENV/bin/python" ]; then
  python3 -m venv "$ANSIBLE_VENV"
fi

if ansible_core_compatible; then
  echo "Совместимая версия Ansible уже установлена."
else
  if ! "$ANSIBLE_VENV/bin/python" -m pip install --disable-pip-version-check --upgrade "$ANSIBLE_CORE_SPEC"; then
    echo "Не удалось установить совместимую версию Ansible из PyPI." >&2
    echo "Проверьте интернет и повторите запуск bootstrap." >&2
    exit 1
  fi
fi
"$ANSIBLE_VENV/bin/ansible" --version | head -n 1

log "[6/6] Устанавливаю Ansible collections"
install_collections

log "Управляющая Ubuntu готова"
print_control_summary

if [ -r /dev/tty ]; then
  echo
  ask_tty "Добавьте ключ у провайдера или выполните команду на VPS, затем нажмите Enter..." >/dev/null
  SERVER_ROLE="$(ask_tty "Какой сервер разворачиваем [main/reserve]: ")"
  SERVER_IP="$(ask_tty "IP сервера: ")"
  "$INSTALL_DIR/scripts/deploy-server" "$SERVER_ROLE" "$SERVER_IP"
fi
