#!/usr/bin/env bash
set -Eeuo pipefail

ARG1="${1:-}"
ARG2="${2:-}"
SERVER_ROLE=""
SERVER_IP=""
MAIN_IP="${VPN_MAIN_IP:-}"
RESERVE_IP="${VPN_RESERVE_IP:-}"
CLIENT_COUNT="${VPN_CLIENT_COUNT:-}"
TELEGRAM_ALERTS="${VPN_TELEGRAM_ALERTS:-}"
TELEGRAM_BOT_TOKEN="${VPN_TELEGRAM_BOT_TOKEN:-}"
TELEGRAM_CHAT_ID="${VPN_TELEGRAM_CHAT_ID:-}"
GRAFANA_ADMIN_PASSWORD="${VPN_GRAFANA_ADMIN_PASSWORD:-}"
GRAFANA_BASIC_AUTH_PASSWORD="${VPN_GRAFANA_BASIC_AUTH_PASSWORD:-}"
ALERTMANAGER_BASIC_AUTH_PASSWORD="${VPN_ALERTMANAGER_BASIC_AUTH_PASSWORD:-}"
GRAFANA_DEB_PATH="${VPN_GRAFANA_DEB_PATH:-}"
CHECK_ATTEMPTS="${VPN_CHECK_ATTEMPTS:-5}"
CHECK_DELAY_SECONDS="${VPN_CHECK_DELAY_SECONDS:-10}"
SSH_KEY_PATH="${VPN_SSH_KEY:-$HOME/.ssh/vpn_ansible}"

ask_tty() {
  local prompt="$1"
  local answer
  if [ ! -r /dev/tty ]; then
    return 1
  fi
  read -r -p "$prompt" answer </dev/tty
  printf '%s' "$answer"
}

ask_tty_secret() {
  local prompt="$1"
  local answer
  if [ ! -r /dev/tty ]; then
    return 1
  fi
  read -r -s -p "$prompt" answer </dev/tty
  printf '\n' >/dev/tty
  printf '%s' "$answer"
}

random_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 24 2>/dev/null && return
  fi
  python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
}

validate_ipv4() {
  local value="$1"
  if ! [[ "$value" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    echo "Ожидался IPv4-адрес, получено: $value" >&2
    exit 1
  fi
}

yes_no() {
  case "$1" in
    y|Y|yes|YES|да|Да|ДА|1|true|TRUE) return 0 ;;
    *) return 1 ;;
  esac
}

add_known_host() {
  local ip="$1"
  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
  if ! ssh-keygen -F "$ip" >/dev/null 2>&1; then
    echo "Добавляю SSH host key для $ip"
    ssh-keyscan -T 5 -H "$ip" >> "$HOME/.ssh/known_hosts"
  fi
}

write_inventory() {
  mkdir -p "$(dirname "$INVENTORY_PATH")"
  {
    cat <<EOF
---
all:
  children:
    vpn_servers:
      hosts:
EOF
    if [ "$SERVER_ROLE" = "reserve" ] && [ -n "$MAIN_IP" ]; then
      cat <<EOF
        vpn-main:
          ansible_host: $MAIN_IP
          ansible_user: root
          ansible_port: 22
          vpn_server_role: main
          vpn_public_endpoint: $MAIN_IP
        vpn-reserve:
          ansible_host: $SERVER_IP
          ansible_user: root
          ansible_port: 22
          vpn_server_role: reserve
          vpn_public_endpoint: $SERVER_IP
EOF
    else
      cat <<EOF
        vpn-${SERVER_ROLE}:
          ansible_host: $SERVER_IP
          ansible_user: root
          ansible_port: 22
          vpn_server_role: $SERVER_ROLE
          vpn_public_endpoint: $SERVER_IP
EOF
    fi
    if [ "$SERVER_ROLE" = "main" ] && [ -n "$RESERVE_IP" ]; then
      cat <<EOF
        vpn-reserve:
          ansible_host: $RESERVE_IP
          ansible_user: root
          ansible_port: 22
          vpn_server_role: reserve
          vpn_public_endpoint: $RESERVE_IP
EOF
    fi
  } > "$INVENTORY_PATH"
}

format_duration() {
  local total_seconds="$1"
  local hours=$((total_seconds / 3600))
  local minutes=$(((total_seconds % 3600) / 60))
  local seconds=$((total_seconds % 60))

  if [ "$hours" -gt 0 ]; then
    printf '%dч %02dм %02dс' "$hours" "$minutes" "$seconds"
  elif [ "$minutes" -gt 0 ]; then
    printf '%dм %02dс' "$minutes" "$seconds"
  else
    printf '%dс' "$seconds"
  fi
}

wait_for_ansible_hosts() {
  local label="$1"
  local attempt

  for attempt in $(seq 1 "$CHECK_ATTEMPTS"); do
    echo "$label: проверка SSH $attempt/$CHECK_ATTEMPTS"
    if "$ANSIBLE_BIN" -i "$INVENTORY_PATH" all -m ping; then
      return 0
    fi

    if [ "$attempt" -lt "$CHECK_ATTEMPTS" ]; then
      echo "$label: SSH пока недоступен, повтор через $CHECK_DELAY_SECONDS секунд..."
      sleep "$CHECK_DELAY_SECONDS"
    fi
  done

  echo "$label: SSH/Ansible не восстановился за $CHECK_ATTEMPTS попыток." >&2
  return 1
}

if [[ "$ARG1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
  SERVER_IP="$ARG1"
  SERVER_ROLE="$ARG2"
else
  SERVER_ROLE="$ARG1"
  SERVER_IP="$ARG2"
fi

if [ -z "$SERVER_ROLE" ]; then
  SERVER_ROLE="$(ask_tty "Какой сервер разворачиваем [main/reserve]: " || true)"
fi

case "$SERVER_ROLE" in
  main|reserve) ;;
  "")
    SERVER_ROLE="main"
    ;;
  *)
    echo "Роль должна быть main или reserve, получено: $SERVER_ROLE" >&2
    exit 1
    ;;
esac

if [ -z "$SERVER_IP" ]; then
  SERVER_IP="$(ask_tty "IP сервера: " || true)"
fi

if [ -z "$SERVER_IP" ]; then
  echo "IP сервера обязателен." >&2
  echo "Использование: scripts/deploy-server [main|reserve] <ip-сервера>" >&2
  echo "Также можно: scripts/deploy-server <ip-сервера> [main|reserve]" >&2
  exit 1
fi

validate_ipv4 "$SERVER_IP"

if [ "$SERVER_ROLE" = "reserve" ] && [ -z "$MAIN_IP" ]; then
  MAIN_IP="$(ask_tty "IP main сервера для подключения monitoring: " || true)"
fi

if [ "$SERVER_ROLE" = "reserve" ] && [ -z "$MAIN_IP" ]; then
  echo "Для reserve deploy нужен IP main сервера, чтобы подключить monitoring." >&2
  echo "Использование: VPN_MAIN_IP=<main-ip> scripts/deploy-server reserve <reserve-ip>" >&2
  exit 1
fi

if [ "$SERVER_ROLE" = "reserve" ]; then
  validate_ipv4 "$MAIN_IP"
  if [ "$MAIN_IP" = "$SERVER_IP" ]; then
    echo "Main IP должен отличаться от IP reserve сервера." >&2
    exit 1
  fi
fi

if [ "$SERVER_ROLE" = "main" ] && [ -z "$RESERVE_IP" ]; then
  RESERVE_EXISTS="$(ask_tty "Reserve node уже есть и её надо добавить в monitoring? [y/N]: " || true)"
  if yes_no "$RESERVE_EXISTS"; then
    RESERVE_IP="$(ask_tty "IP reserve сервера: " || true)"
  fi
fi

if [ -n "$RESERVE_IP" ]; then
  validate_ipv4 "$RESERVE_IP"
  if [ "$RESERVE_IP" = "$SERVER_IP" ]; then
    echo "Reserve IP должен отличаться от IP текущего main сервера." >&2
    exit 1
  fi
fi

if [ -z "$CLIENT_COUNT" ]; then
  CLIENT_COUNT="$(ask_tty "Сколько Amnezia ключей генерить [100]: " || true)"
fi

if [ -z "$CLIENT_COUNT" ]; then
  CLIENT_COUNT="100"
fi

if ! [[ "$CLIENT_COUNT" =~ ^[0-9]+$ ]] || [ "$CLIENT_COUNT" -lt 1 ] || [ "$CLIENT_COUNT" -gt 253 ]; then
  echo "Количество Amnezia ключей должно быть числом от 1 до 253, получено: $CLIENT_COUNT" >&2
  exit 1
fi

printf -v LAST_CLIENT_ID "client-%03d" "$CLIENT_COUNT"

if [ "$SERVER_ROLE" = "main" ]; then
  if [ -z "$TELEGRAM_ALERTS" ]; then
    TELEGRAM_ALERTS="$(ask_tty "Подключить Telegram alerts через Alertmanager? [y/N]: " || true)"
  fi

  case "$TELEGRAM_ALERTS" in
    y|Y|yes|YES|да|Да|ДА|1|true|TRUE)
      TELEGRAM_ALERTS="true"
      ;;
    *)
      TELEGRAM_ALERTS="false"
      ;;
  esac

  if [ "$TELEGRAM_ALERTS" = "true" ]; then
    if [ -z "$TELEGRAM_BOT_TOKEN" ]; then
      TELEGRAM_BOT_TOKEN="$(ask_tty_secret "Telegram bot token для alerts: " || true)"
    fi
    if [ -z "$TELEGRAM_CHAT_ID" ]; then
      TELEGRAM_CHAT_ID="$(ask_tty "Telegram chat/channel id для alerts: " || true)"
    fi
    if [ -z "$TELEGRAM_BOT_TOKEN" ] || [ -z "$TELEGRAM_CHAT_ID" ]; then
      echo "Для Telegram alerts нужны token и chat/channel id." >&2
      exit 1
    fi
  fi

  if [ -z "$GRAFANA_ADMIN_PASSWORD" ]; then
    GRAFANA_ADMIN_PASSWORD="$(ask_tty_secret "Grafana admin password [auto-generate]: " || true)"
  fi
  if [ -z "$GRAFANA_ADMIN_PASSWORD" ]; then
    GRAFANA_ADMIN_PASSWORD="$(random_secret)"
    echo "Grafana admin password сгенерирован автоматически. Сохраните его из этого вывода: $GRAFANA_ADMIN_PASSWORD"
  fi

  if [ -z "$GRAFANA_BASIC_AUTH_PASSWORD" ]; then
    GRAFANA_BASIC_AUTH_PASSWORD="$GRAFANA_ADMIN_PASSWORD"
  fi
  if [ -z "$ALERTMANAGER_BASIC_AUTH_PASSWORD" ]; then
    ALERTMANAGER_BASIC_AUTH_PASSWORD="$GRAFANA_BASIC_AUTH_PASSWORD"
  fi

  if [ -n "$GRAFANA_DEB_PATH" ] && [ ! -r "$GRAFANA_DEB_PATH" ]; then
    echo "VPN_GRAFANA_DEB_PATH задан, но файл не читается: $GRAFANA_DEB_PATH" >&2
    exit 1
  fi
fi

if [ "$SERVER_ROLE" = "main" ]; then
  MONITORING_STACK_SUMMARY="Monitoring stack: Prometheus + Alertmanager + Grafana"
  GRAFANA_ACCESS_SUMMARY="Grafana доступна извне по HTTPS + Basic Auth: https://$SERVER_IP/ (self-signed TLS)"
  ALERTMANAGER_ACCESS_SUMMARY="Alertmanager доступен извне по HTTPS + Basic Auth: https://$SERVER_IP:9443/ (self-signed TLS)"
  PROMETHEUS_ACCESS_SUMMARY="Prometheus доступен извне по HTTPS + Basic Auth: https://$SERVER_IP:9445/ (self-signed TLS)"
else
  if [ -n "$MAIN_IP" ]; then
    MONITORING_STACK_SUMMARY="Monitoring stack: exporters на reserve, Prometheus targets обновлены на main"
  else
    MONITORING_STACK_SUMMARY="Monitoring stack: не ставился на reserve; ставится на main"
  fi
  GRAFANA_ACCESS_SUMMARY="Grafana живёт на main и доступна только из VPN"
  ALERTMANAGER_ACCESS_SUMMARY="Alertmanager живёт на main и доступен только там"
  PROMETHEUS_ACCESS_SUMMARY="Prometheus живёт на main и доступен только там"
fi

cd "$(dirname "$0")/.."

INVENTORY_PATH="$PWD/inventories/managed/hosts.yml"
ANSIBLE_BIN="$PWD/.venv/bin/ansible"
ANSIBLE_PLAYBOOK_BIN="$PWD/.venv/bin/ansible-playbook"
MONITORING_EXTRA_VARS_FILE=""
DEPLOY_STARTED_AT=0

cleanup() {
  if [ -n "$MONITORING_EXTRA_VARS_FILE" ]; then
    rm -f "$MONITORING_EXTRA_VARS_FILE"
  fi
}

on_exit() {
  local rc=$?
  cleanup
  if [ "$rc" -ne 0 ] && [ "$DEPLOY_STARTED_AT" -gt 0 ]; then
    echo "Deploy завершился с ошибкой за $(format_duration "$(( $(date +%s) - DEPLOY_STARTED_AT ))")." >&2
  fi
}
trap on_exit EXIT

if [ ! -x "$ANSIBLE_BIN" ] || [ ! -x "$ANSIBLE_PLAYBOOK_BIN" ]; then
  echo "Совместимая версия Ansible не установлена." >&2
  echo "Сначала запустите: VPN_DIR=\"$PWD\" bash scripts/bootstrap-ubuntu-control" >&2
  exit 1
fi

write_inventory
add_known_host "$SERVER_IP"
if [ -n "$MAIN_IP" ]; then
  add_known_host "$MAIN_IP"
fi
if [ -n "$RESERVE_IP" ]; then
  add_known_host "$RESERVE_IP"
  if [ -r /dev/tty ]; then
    echo
    echo "Один и тот же публичный Ansible SSH-ключ должен быть добавлен на main и reserve:"
    echo "  $SSH_KEY_PATH.pub -> /root/.ssh/authorized_keys"
    if [ -r "$SSH_KEY_PATH.pub" ]; then
      echo
      cat "$SSH_KEY_PATH.pub"
      echo
    fi
    ask_tty "Убедитесь, что ключ добавлен на оба VPS, затем нажмите Enter..." >/dev/null
  fi
fi

cat <<EOF
===== VPN DEPLOY =====
Сервер:
  роль: $SERVER_ROLE
  IP: $SERVER_IP
  main IP для monitoring: ${MAIN_IP:-не задан}
  reserve IP: ${RESERVE_IP:-не задан}
  Amnezia клиентов: $CLIENT_COUNT
  inventory: $INVENTORY_PATH

Что произойдёт:
  1. SSH/Ansible preflight
  2. deploy playbooks/vpn-core.yml для выбранной роли
  3. deploy monitoring layer
  4. проверка результата с retry

Пользователю не нужно руками указывать Ansible inventory:
  scripts/deploy-server создаст inventories/managed/hosts.yml внутри репозитория.
===== КОНЕЦ ВВОДНЫХ =====
EOF

DEPLOY_STARTED_AT="$(date +%s)"

echo
echo "==> [1/4] Preflight"
"$ANSIBLE_BIN" --version | head -n 1
"$ANSIBLE_BIN" -i "$INVENTORY_PATH" all -m ping
"$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY_PATH" playbooks/preflight.yml

echo
echo "==> [2/4] Deploy VPN core"
VPN_CORE_LIMIT_ARGS=()
if [ "$SERVER_ROLE" = "reserve" ]; then
  VPN_CORE_LIMIT_ARGS=(--limit vpn-reserve)
fi
"$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY_PATH" playbooks/vpn-core.yml "${VPN_CORE_LIMIT_ARGS[@]}" -e "vpn_client_count=$CLIENT_COUNT"

wait_for_ansible_hosts "После VPN core"

echo
echo "==> [3/4] Deploy monitoring layer"
if [ "$SERVER_ROLE" = "main" ]; then
  MONITORING_EXTRA_VARS_FILE="$(mktemp)"
  export TELEGRAM_ALERTS TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID GRAFANA_ADMIN_PASSWORD GRAFANA_BASIC_AUTH_PASSWORD ALERTMANAGER_BASIC_AUTH_PASSWORD GRAFANA_DEB_PATH
  python3 - "$MONITORING_EXTRA_VARS_FILE" <<'PY'
import json
import os
import sys

data = {
    "monitoring_alertmanager_telegram_enabled": os.environ["TELEGRAM_ALERTS"] == "true",
    "monitoring_alertmanager_telegram_bot_token": os.environ.get("TELEGRAM_BOT_TOKEN", ""),
    "monitoring_alertmanager_telegram_chat_id": os.environ.get("TELEGRAM_CHAT_ID", ""),
    "monitoring_grafana_admin_password": os.environ.get("GRAFANA_ADMIN_PASSWORD", ""),
    "monitoring_grafana_basic_auth_password": os.environ.get("GRAFANA_BASIC_AUTH_PASSWORD", ""),
    "monitoring_alertmanager_basic_auth_password": os.environ.get("ALERTMANAGER_BASIC_AUTH_PASSWORD", ""),
    "monitoring_grafana_deb_path": os.environ.get("GRAFANA_DEB_PATH", ""),
}
with open(sys.argv[1], "w") as fh:
    json.dump(data, fh)
PY
  chmod 600 "$MONITORING_EXTRA_VARS_FILE"
  "$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY_PATH" playbooks/monitoring.yml -e "@$MONITORING_EXTRA_VARS_FILE"
else
  if [ -n "$MAIN_IP" ]; then
    "$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY_PATH" playbooks/connect-reserve-monitoring.yml
  else
    "$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY_PATH" playbooks/monitoring.yml
  fi
fi

echo
echo "==> [4/4] Проверка результата"
for attempt in $(seq 1 "$CHECK_ATTEMPTS"); do
  echo "Проверка $attempt/$CHECK_ATTEMPTS"
  if "$ANSIBLE_BIN" -i "$INVENTORY_PATH" all -m ping && "$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY_PATH" playbooks/preflight.yml; then
    DEPLOY_FINISHED_AT="$(date +%s)"
    DEPLOY_DURATION_SECONDS=$((DEPLOY_FINISHED_AT - DEPLOY_STARTED_AT))
    DEPLOY_DURATION="$(format_duration "$DEPLOY_DURATION_SECONDS")"
    cat <<EOF

===== ИТОГ DEPLOY =====
Сервер:
  роль: $SERVER_ROLE
  IP: $SERVER_IP
  main IP для monitoring: ${MAIN_IP:-не задан}
  reserve IP: ${RESERVE_IP:-не задан}
  Amnezia клиентов: $CLIENT_COUNT
  inventory: $INVENTORY_PATH

Deploy завершён.
Проверка результата успешна.
Время развёртывания: $DEPLOY_DURATION

Развернули:
  Native AmneziaWG: awg0 via awg-quick, UDP/443
  DNS для VPN-клиентов: Unbound на 10.8.0.1 и fd00:8::1
  Резервный канал: Xray VLESS Reality, TCP/8443 xhttp и TCP/8444 tcp
  Firewall/UFW + fail2ban
  Клиенты AmneziaVPN/AmneziaWG: $CLIENT_COUNT штук
  Monitoring agent: node_exporter + vpn-custom-exporter
  $MONITORING_STACK_SUMMARY

Клиентские артефакты на VPS:
  /var/lib/vpn/amnezia-vpn-links.txt       # $CLIENT_COUNT ссылок vpn://
  /var/lib/vpn/amneziawg-client-configs.txt # $CLIENT_COUNT .awg.conf подряд
  /var/lib/vpn/client-001.awg.conf .. /var/lib/vpn/$LAST_CLIENT_ID.awg.conf
  /var/lib/vpn/client-links.txt             # индекс экспортов + Xray/VLESS links

Следующий этап:
  $GRAFANA_ACCESS_SUMMARY
  $ALERTMANAGER_ACCESS_SUMMARY
  $PROMETHEUS_ACCESS_SUMMARY
===== КОНЕЦ ИТОГА =====
EOF
    exit 0
  fi

  if [ "$attempt" -lt "$CHECK_ATTEMPTS" ]; then
    echo "Проверка не прошла, повтор через $CHECK_DELAY_SECONDS секунд..."
    sleep "$CHECK_DELAY_SECONDS"
  fi
done

echo "Deploy выполнен, но итоговая проверка не прошла за $CHECK_ATTEMPTS попыток." >&2
exit 1
