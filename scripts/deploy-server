#!/usr/bin/env bash
set -Eeuo pipefail

ARG1="${1:-}"
ARG2="${2:-}"
SERVER_ROLE=""
SERVER_IP=""
CLIENT_COUNT="${VPN_CLIENT_COUNT:-}"
TELEGRAM_ALERTS="${VPN_TELEGRAM_ALERTS:-}"
TELEGRAM_BOT_TOKEN="${VPN_TELEGRAM_BOT_TOKEN:-}"
TELEGRAM_CHAT_ID="${VPN_TELEGRAM_CHAT_ID:-}"
GRAFANA_ADMIN_PASSWORD="${VPN_GRAFANA_ADMIN_PASSWORD:-}"
GRAFANA_BASIC_AUTH_PASSWORD="${VPN_GRAFANA_BASIC_AUTH_PASSWORD:-}"
CHECK_ATTEMPTS="${VPN_CHECK_ATTEMPTS:-5}"
CHECK_DELAY_SECONDS="${VPN_CHECK_DELAY_SECONDS:-10}"

ask_tty() {
  local prompt="$1"
  local answer
  if [ ! -r /dev/tty ]; then
    return 1
  fi
  read -r -p "$prompt" answer </dev/tty
  printf '%s' "$answer"
}

ask_tty_secret() {
  local prompt="$1"
  local answer
  if [ ! -r /dev/tty ]; then
    return 1
  fi
  read -r -s -p "$prompt" answer </dev/tty
  printf '\n' >/dev/tty
  printf '%s' "$answer"
}

random_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 24 2>/dev/null && return
  fi
  python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
}

if [[ "$ARG1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
  SERVER_IP="$ARG1"
  SERVER_ROLE="$ARG2"
else
  SERVER_ROLE="$ARG1"
  SERVER_IP="$ARG2"
fi

if [ -z "$SERVER_ROLE" ]; then
  SERVER_ROLE="$(ask_tty "Какой сервер разворачиваем [main/reserve]: " || true)"
fi

case "$SERVER_ROLE" in
  main|reserve) ;;
  "")
    SERVER_ROLE="main"
    ;;
  *)
    echo "Роль должна быть main или reserve, получено: $SERVER_ROLE" >&2
    exit 1
    ;;
esac

if [ -z "$SERVER_IP" ]; then
  SERVER_IP="$(ask_tty "IP сервера: " || true)"
fi

if [ -z "$SERVER_IP" ]; then
  echo "IP сервера обязателен." >&2
  echo "Использование: scripts/deploy-server [main|reserve] <ip-сервера>" >&2
  echo "Также можно: scripts/deploy-server <ip-сервера> [main|reserve]" >&2
  exit 1
fi

if ! [[ "$SERVER_IP" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
  echo "Ожидался IPv4-адрес, получено: $SERVER_IP" >&2
  exit 1
fi

if [ -z "$CLIENT_COUNT" ]; then
  CLIENT_COUNT="$(ask_tty "Сколько Amnezia ключей генерить [100]: " || true)"
fi

if [ -z "$CLIENT_COUNT" ]; then
  CLIENT_COUNT="100"
fi

if ! [[ "$CLIENT_COUNT" =~ ^[0-9]+$ ]] || [ "$CLIENT_COUNT" -lt 1 ] || [ "$CLIENT_COUNT" -gt 253 ]; then
  echo "Количество Amnezia ключей должно быть числом от 1 до 253, получено: $CLIENT_COUNT" >&2
  exit 1
fi

printf -v LAST_CLIENT_ID "client-%03d" "$CLIENT_COUNT"

if [ "$SERVER_ROLE" = "main" ]; then
  if [ -z "$TELEGRAM_ALERTS" ]; then
    TELEGRAM_ALERTS="$(ask_tty "Подключить Telegram alerts через Alertmanager? [y/N]: " || true)"
  fi

  case "$TELEGRAM_ALERTS" in
    y|Y|yes|YES|да|Да|ДА|1|true|TRUE)
      TELEGRAM_ALERTS="true"
      ;;
    *)
      TELEGRAM_ALERTS="false"
      ;;
  esac

  if [ "$TELEGRAM_ALERTS" = "true" ]; then
    if [ -z "$TELEGRAM_BOT_TOKEN" ]; then
      TELEGRAM_BOT_TOKEN="$(ask_tty_secret "Telegram bot token для alerts: " || true)"
    fi
    if [ -z "$TELEGRAM_CHAT_ID" ]; then
      TELEGRAM_CHAT_ID="$(ask_tty "Telegram chat/channel id для alerts: " || true)"
    fi
    if [ -z "$TELEGRAM_BOT_TOKEN" ] || [ -z "$TELEGRAM_CHAT_ID" ]; then
      echo "Для Telegram alerts нужны token и chat/channel id." >&2
      exit 1
    fi
  fi

  if [ -z "$GRAFANA_ADMIN_PASSWORD" ]; then
    GRAFANA_ADMIN_PASSWORD="$(ask_tty_secret "Grafana admin password [auto-generate]: " || true)"
  fi
  if [ -z "$GRAFANA_ADMIN_PASSWORD" ]; then
    GRAFANA_ADMIN_PASSWORD="$(random_secret)"
    echo "Grafana admin password сгенерирован автоматически. Сохраните его из этого вывода: $GRAFANA_ADMIN_PASSWORD"
  fi

  if [ -z "$GRAFANA_BASIC_AUTH_PASSWORD" ]; then
    GRAFANA_BASIC_AUTH_PASSWORD="$GRAFANA_ADMIN_PASSWORD"
  fi
fi

if [ "$SERVER_ROLE" = "main" ]; then
  MONITORING_STACK_SUMMARY="Monitoring stack: Prometheus + Alertmanager + Grafana"
  GRAFANA_ACCESS_SUMMARY="Grafana доступна извне по HTTPS + Basic Auth: https://$SERVER_IP/ (self-signed TLS)"
else
  MONITORING_STACK_SUMMARY="Monitoring stack: не ставился на reserve; ставится на main"
  GRAFANA_ACCESS_SUMMARY="Grafana живёт на main и доступна только из VPN"
fi

cd "$(dirname "$0")/.."

ANSIBLE_PLAYBOOK_BIN="$PWD/.venv/bin/ansible-playbook"
MONITORING_EXTRA_VARS_FILE=""

cleanup() {
  if [ -n "$MONITORING_EXTRA_VARS_FILE" ]; then
    rm -f "$MONITORING_EXTRA_VARS_FILE"
  fi
}
trap cleanup EXIT

if [ ! -x "$ANSIBLE_PLAYBOOK_BIN" ]; then
  echo "Совместимая версия Ansible не установлена." >&2
  echo "Сначала запустите: VPN_DIR=\"$PWD\" bash scripts/bootstrap-ubuntu-control" >&2
  exit 1
fi

cat <<EOF
===== VPN DEPLOY =====
Сервер:
  роль: $SERVER_ROLE
  IP: $SERVER_IP
  Amnezia клиентов: $CLIENT_COUNT

Что произойдёт:
  1. SSH/Ansible preflight
  2. deploy всего playbooks/vpn-core.yml
  3. deploy monitoring layer
  4. проверка результата с retry

Пользователю не нужно руками указывать Ansible inventory:
  scripts/check-server создаст inventories/test/hosts.yml внутри репозитория.
===== КОНЕЦ ВВОДНЫХ =====
EOF

echo
echo "==> [1/4] Preflight"
scripts/check-server "$SERVER_IP" "$SERVER_ROLE"

echo
echo "==> [2/4] Deploy full VPN core"
"$ANSIBLE_PLAYBOOK_BIN" -i inventories/test/hosts.yml playbooks/vpn-core.yml -e "vpn_client_count=$CLIENT_COUNT"

echo
echo "==> [3/4] Deploy monitoring layer"
if [ "$SERVER_ROLE" = "main" ]; then
  MONITORING_EXTRA_VARS_FILE="$(mktemp)"
  export TELEGRAM_ALERTS TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID GRAFANA_ADMIN_PASSWORD GRAFANA_BASIC_AUTH_PASSWORD
  python3 - "$MONITORING_EXTRA_VARS_FILE" <<'PY'
import json
import os
import sys

data = {
    "monitoring_alertmanager_telegram_enabled": os.environ["TELEGRAM_ALERTS"] == "true",
    "monitoring_alertmanager_telegram_bot_token": os.environ.get("TELEGRAM_BOT_TOKEN", ""),
    "monitoring_alertmanager_telegram_chat_id": os.environ.get("TELEGRAM_CHAT_ID", ""),
    "monitoring_grafana_admin_password": os.environ.get("GRAFANA_ADMIN_PASSWORD", ""),
    "monitoring_grafana_basic_auth_password": os.environ.get("GRAFANA_BASIC_AUTH_PASSWORD", ""),
}
with open(sys.argv[1], "w") as fh:
    json.dump(data, fh)
PY
  chmod 600 "$MONITORING_EXTRA_VARS_FILE"
  "$ANSIBLE_PLAYBOOK_BIN" -i inventories/test/hosts.yml playbooks/monitoring.yml -e "@$MONITORING_EXTRA_VARS_FILE"
else
  "$ANSIBLE_PLAYBOOK_BIN" -i inventories/test/hosts.yml playbooks/monitoring.yml
fi

echo
echo "==> [4/4] Проверка результата"
for attempt in $(seq 1 "$CHECK_ATTEMPTS"); do
  echo "Проверка $attempt/$CHECK_ATTEMPTS"
  if scripts/check-server "$SERVER_IP" "$SERVER_ROLE"; then
    cat <<EOF

===== ИТОГ DEPLOY =====
Сервер:
  роль: $SERVER_ROLE
  IP: $SERVER_IP
  Amnezia клиентов: $CLIENT_COUNT

Deploy завершён.
Проверка результата успешна.

Развернули:
  Native AmneziaWG: awg0 via awg-quick, UDP/443
  DNS для VPN-клиентов: Unbound на 10.8.0.1 и fd00:8::1
  Резервный канал: Xray VLESS Reality, TCP/8443 xhttp и TCP/8444 tcp
  Firewall/UFW + fail2ban
  Клиенты AmneziaVPN/AmneziaWG: $CLIENT_COUNT штук
  Monitoring agent: node_exporter + vpn-custom-exporter
  $MONITORING_STACK_SUMMARY

Клиентские артефакты на VPS:
  /var/lib/vpn/amnezia-vpn-links.txt       # $CLIENT_COUNT ссылок vpn://
  /var/lib/vpn/amneziawg-client-configs.txt # $CLIENT_COUNT .awg.conf подряд
  /var/lib/vpn/client-001.awg.conf .. /var/lib/vpn/$LAST_CLIENT_ID.awg.conf
  /var/lib/vpn/client-links.txt             # индекс экспортов + Xray/VLESS links

Следующий этап:
  $GRAFANA_ACCESS_SUMMARY
  Prometheus и Alertmanager слушают localhost и не открыты наружу
===== КОНЕЦ ИТОГА =====
EOF
    exit 0
  fi

  if [ "$attempt" -lt "$CHECK_ATTEMPTS" ]; then
    echo "Проверка не прошла, повтор через $CHECK_DELAY_SECONDS секунд..."
    sleep "$CHECK_DELAY_SECONDS"
  fi
done

echo "Deploy выполнен, но итоговая проверка не прошла за $CHECK_ATTEMPTS попыток." >&2
exit 1
