#!/usr/bin/env bash
set -Eeuo pipefail

PHASE="${VPN_PHASE:-all}"
if [ "${1:-}" = "--phase" ]; then
  PHASE="${2:?phase required}"
  shift 2
fi
case "$PHASE" in all|core|monitoring|exporter) ;; *) echo 'Phase: all/core/monitoring/exporter' >&2; exit 1 ;; esac
ARG1="${1:-}"
ARG2="${2:-}"
SERVER_ROLE=""
SERVER_IP=""
MAIN_IP="${VPN_MAIN_IP:-}"
RESERVE_IP="${VPN_RESERVE_IP:-}"
CLIENT_COUNT="${VPN_CLIENT_COUNT:-}"
INSTALL_MTPROTO="${VPN_INSTALL_MTPROTO:-}"
INSTALL_SOCKS5="${VPN_INSTALL_SOCKS5:-}"
TELEGRAM_ALERTS="${VPN_TELEGRAM_ALERTS:-}"
TELEGRAM_BOT_TOKEN="${VPN_TELEGRAM_BOT_TOKEN:-}"
TELEGRAM_CHAT_ID="${VPN_TELEGRAM_CHAT_ID:-}"
GRAFANA_ADMIN_PASSWORD="${VPN_GRAFANA_ADMIN_PASSWORD:-}"
GRAFANA_BASIC_AUTH_PASSWORD="${VPN_GRAFANA_BASIC_AUTH_PASSWORD:-}"
ALERTMANAGER_BASIC_AUTH_PASSWORD="${VPN_ALERTMANAGER_BASIC_AUTH_PASSWORD:-}"
GRAFANA_DEB_PATH="${VPN_GRAFANA_DEB_PATH:-}"
SSH_KEY_PATH="${VPN_SSH_KEY:-$HOME/.ssh/vpn_ansible}"

ask_tty() {
  local prompt="$1"
  local answer
  if [ "${VPN_NONINTERACTIVE:-0}" = 1 ] || [ ! -r /dev/tty ]; then
    return 1
  fi
  read -r -p "$prompt" answer </dev/tty
  printf '%s' "$answer"
}

ask_tty_secret() {
  local prompt="$1"
  local answer
  if [ "${VPN_NONINTERACTIVE:-0}" = 1 ] || [ ! -r /dev/tty ]; then
    return 1
  fi
  read -r -s -p "$prompt" answer </dev/tty
  printf '\n' >/dev/tty
  printf '%s' "$answer"
}

random_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 24 2>/dev/null && return
  fi
  python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
}

validate_ipv4() {
  local value="$1"
  python3 - "$value" <<'PY'
import ipaddress, sys
try:
    ipaddress.IPv4Address(sys.argv[1])
except ValueError:
    sys.exit('Invalid IPv4: ' + sys.argv[1])
PY
}

yes_no() {
  case "$1" in
    y|Y|yes|YES|да|Да|ДА|1|true|TRUE) return 0 ;;
    *) return 1 ;;
  esac
}

normalize_yes_no() {
  local value="$1"
  local prompt="$2"
  if [ -z "$value" ]; then
    value="$(ask_tty "$prompt [y/N]: " || true)"
  fi
  case "${value,,}" in
    y|yes|да|д|1|true) printf 'true' ;;
    n|no|нет|н|0|false|"") printf 'false' ;;
    *) echo "Ожидался ответ yes/no, получено: $value" >&2; return 1 ;;
  esac
}

add_known_host() {
  local ip="$1"
  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
  if ! ssh-keygen -F "$ip" >/dev/null 2>&1; then
    echo "Добавляю SSH host key для $ip"
    ssh-keyscan -T 5 -H "$ip" >> "$HOME/.ssh/known_hosts"
  fi
}

write_inventory() {
  mkdir -p "$(dirname "$INVENTORY_PATH")"
  {
    cat <<EOF
---
all:
  children:
    vpn_servers:
      hosts:
EOF
    if [ "$SERVER_ROLE" = "reserve" ] && [ -n "$MAIN_IP" ]; then
      cat <<EOF
        vpn-main:
          ansible_host: $MAIN_IP
          ansible_user: root
          ansible_port: 22
          vpn_server_role: main
          vpn_public_endpoint: $MAIN_IP
        vpn-reserve:
          ansible_host: $SERVER_IP
          ansible_user: root
          ansible_port: 22
          vpn_server_role: reserve
          vpn_public_endpoint: $SERVER_IP
EOF
    else
      cat <<EOF
        vpn-${SERVER_ROLE}:
          ansible_host: $SERVER_IP
          ansible_user: root
          ansible_port: 22
          vpn_server_role: $SERVER_ROLE
          vpn_public_endpoint: $SERVER_IP
EOF
    fi
    if [ "$SERVER_ROLE" = "main" ] && [ -n "$RESERVE_IP" ]; then
      cat <<EOF
        vpn-reserve:
          ansible_host: $RESERVE_IP
          ansible_user: root
          ansible_port: 22
          vpn_server_role: reserve
          vpn_public_endpoint: $RESERVE_IP
EOF
    fi
  } > "$INVENTORY_PATH"
}

format_duration() {
  local total_seconds="$1"
  local hours=$((total_seconds / 3600))
  local minutes=$(((total_seconds % 3600) / 60))
  local seconds=$((total_seconds % 60))

  if [ "$hours" -gt 0 ]; then
    printf '%dч %02dм %02dс' "$hours" "$minutes" "$seconds"
  elif [ "$minutes" -gt 0 ]; then
    printf '%dм %02dс' "$minutes" "$seconds"
  else
    printf '%dс' "$seconds"
  fi
}

if [[ "$ARG1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
  SERVER_IP="$ARG1"
  SERVER_ROLE="$ARG2"
else
  SERVER_ROLE="$ARG1"
  SERVER_IP="$ARG2"
fi

if [ -z "$SERVER_ROLE" ]; then
  SERVER_ROLE="$(ask_tty "Какой сервер разворачиваем [main/reserve]: " || true)"
fi

case "$SERVER_ROLE" in
  main|reserve) ;;
  "")
    SERVER_ROLE="main"
    ;;
  *)
    echo "Роль должна быть main или reserve, получено: $SERVER_ROLE" >&2
    exit 1
    ;;
esac

if [ -z "$SERVER_IP" ]; then
  SERVER_IP="$(ask_tty "IP сервера: " || true)"
fi

if [ -z "$SERVER_IP" ]; then
  echo "IP сервера обязателен." >&2
  echo "Использование: scripts/deploy-server [main|reserve] <ip-сервера>" >&2
  echo "Также можно: scripts/deploy-server <ip-сервера> [main|reserve]" >&2
  exit 1
fi

validate_ipv4 "$SERVER_IP"


cd "$(dirname "$0")/.."
ANSIBLE_BIN="$PWD/.venv/bin/ansible"
ANSIBLE_PLAYBOOK_BIN="$PWD/.venv/bin/ansible-playbook"
if [ ! -x "$ANSIBLE_PLAYBOOK_BIN" ]; then
  echo 'Run scripts/bootstrap-ubuntu-control first.' >&2
  exit 1
fi
export ANSIBLE_PRIVATE_KEY_FILE="$SSH_KEY_PATH"
add_known_host "$SERVER_IP"
SSH_ARGS=(-i "$SSH_KEY_PATH" -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=10)
DISCOVERY="$(ssh "${SSH_ARGS[@]}" "root@$SERVER_IP" 'python3 - discover' < scripts/vpn-network.py)"
state_value() {
  python3 -c 'import json,sys; v=json.load(sys.stdin)["state"].get(sys.argv[1], ""); print(str(v).lower() if isinstance(v,bool) else v)' "$1" <<<"$DISCOVERY"
}
CLIENT_COUNT="${CLIENT_COUNT:-$(state_value vpn_client_count)}"
INSTALL_MTPROTO="${INSTALL_MTPROTO:-$(state_value install_mtproto)}"
INSTALL_SOCKS5="${INSTALL_SOCKS5:-$(state_value install_socks5)}"
INVENTORY_PATH="$PWD/inventories/managed/$SERVER_IP/hosts.yml"
MONITORING_EXTRA_VARS_FILE=""
NETWORK_VARS_FILE="$(mktemp)"
DEPLOY_STARTED_AT="$(date +%s)"
cleanup() {
  rm -f "$NETWORK_VARS_FILE"
  if [ -n "$MONITORING_EXTRA_VARS_FILE" ]; then rm -f "$MONITORING_EXTRA_VARS_FILE"; fi
}
trap cleanup EXIT
TARGET="vpn-$SERVER_ROLE"

configure_monitoring() {
if [ "$SERVER_ROLE" = main ]; then
  MONITORING_STATE="$(ssh "${SSH_ARGS[@]}" "root@$SERVER_IP" 'python3 - monitoring-settings' < scripts/monitoring-state.py)"
  monitoring_value() {
    python3 -c 'import json,sys; v=json.load(sys.stdin).get(sys.argv[1], ""); print(str(v).lower() if isinstance(v,bool) else v)' "$1" <<<"$MONITORING_STATE"
  }
  TELEGRAM_ALERTS="${TELEGRAM_ALERTS:-$(monitoring_value monitoring_alertmanager_telegram_enabled)}"
  TELEGRAM_BOT_TOKEN="${TELEGRAM_BOT_TOKEN:-$(monitoring_value monitoring_alertmanager_telegram_bot_token)}"
  TELEGRAM_CHAT_ID="${TELEGRAM_CHAT_ID:-$(monitoring_value monitoring_alertmanager_telegram_chat_id)}"
  GRAFANA_ADMIN_PASSWORD="${GRAFANA_ADMIN_PASSWORD:-$(monitoring_value monitoring_grafana_admin_password)}"
  GRAFANA_BASIC_AUTH_PASSWORD="${GRAFANA_BASIC_AUTH_PASSWORD:-$(monitoring_value monitoring_grafana_basic_auth_password)}"
  ALERTMANAGER_BASIC_AUTH_PASSWORD="${ALERTMANAGER_BASIC_AUTH_PASSWORD:-$(monitoring_value monitoring_alertmanager_basic_auth_password)}"
fi
if [ "$SERVER_ROLE" = "reserve" ] && [ -z "$MAIN_IP" ]; then
  MAIN_IP="$(ask_tty "IP main сервера для подключения monitoring: " || true)"
fi

if [ "$SERVER_ROLE" = "reserve" ] && [ -z "$MAIN_IP" ]; then
  echo "Для reserve deploy нужен IP main сервера, чтобы подключить monitoring." >&2
  echo "Использование: VPN_MAIN_IP=<main-ip> scripts/deploy-server reserve <reserve-ip>" >&2
  exit 1
fi

if [ "$SERVER_ROLE" = "reserve" ]; then
  validate_ipv4 "$MAIN_IP"
  if [ "$MAIN_IP" = "$SERVER_IP" ]; then
    echo "Main IP должен отличаться от IP reserve сервера." >&2
    exit 1
  fi
fi

if [ "$SERVER_ROLE" = "main" ] && [ -z "$RESERVE_IP" ]; then
  RESERVE_EXISTS="$(ask_tty "Reserve node уже есть и её надо добавить в monitoring? [y/N]: " || true)"
  if yes_no "$RESERVE_EXISTS"; then
    RESERVE_IP="$(ask_tty "IP reserve сервера: " || true)"
  fi
fi

if [ -n "$RESERVE_IP" ]; then
  validate_ipv4 "$RESERVE_IP"
  if [ "$RESERVE_IP" = "$SERVER_IP" ]; then
    echo "Reserve IP должен отличаться от IP текущего main сервера." >&2
    exit 1
  fi
fi

if [ "$SERVER_ROLE" = "main" ]; then
  if [ -z "$TELEGRAM_ALERTS" ]; then
    TELEGRAM_ALERTS="$(ask_tty "Подключить Telegram alerts через Alertmanager? [y/N]: " || true)"
  fi

  case "$TELEGRAM_ALERTS" in
    y|Y|yes|YES|да|Да|ДА|1|true|TRUE)
      TELEGRAM_ALERTS="true"
      ;;
    *)
      TELEGRAM_ALERTS="false"
      ;;
  esac

  if [ "$TELEGRAM_ALERTS" = "true" ]; then
    if [ -z "$TELEGRAM_BOT_TOKEN" ]; then
      TELEGRAM_BOT_TOKEN="$(ask_tty_secret "Telegram bot token для alerts: " || true)"
    fi
    if [ -z "$TELEGRAM_CHAT_ID" ]; then
      TELEGRAM_CHAT_ID="$(ask_tty "Telegram chat/channel id для alerts: " || true)"
    fi
    if [ -z "$TELEGRAM_BOT_TOKEN" ] || [ -z "$TELEGRAM_CHAT_ID" ]; then
      echo "Для Telegram alerts нужны token и chat/channel id." >&2
      exit 1
    fi
  fi

  if [ -z "$GRAFANA_ADMIN_PASSWORD" ]; then
    GRAFANA_ADMIN_PASSWORD="$(ask_tty_secret "Grafana admin password [auto-generate]: " || true)"
  fi
  if [ -z "$GRAFANA_ADMIN_PASSWORD" ]; then
    GRAFANA_ADMIN_PASSWORD="$(random_secret)"
    echo "Grafana admin password сгенерирован автоматически. Сохраните его из этого вывода: $GRAFANA_ADMIN_PASSWORD"
  fi

  if [ -z "$GRAFANA_BASIC_AUTH_PASSWORD" ]; then
    GRAFANA_BASIC_AUTH_PASSWORD="$GRAFANA_ADMIN_PASSWORD"
  fi
  if [ -z "$ALERTMANAGER_BASIC_AUTH_PASSWORD" ]; then
    ALERTMANAGER_BASIC_AUTH_PASSWORD="$GRAFANA_BASIC_AUTH_PASSWORD"
  fi

  if [ -n "$GRAFANA_DEB_PATH" ] && [ ! -r "$GRAFANA_DEB_PATH" ]; then
    echo "VPN_GRAFANA_DEB_PATH задан, но файл не читается: $GRAFANA_DEB_PATH" >&2
    exit 1
  fi
fi


}

if [ "$PHASE" = all ] || [ "$PHASE" = core ]; then
if [ -z "$CLIENT_COUNT" ]; then
  CLIENT_COUNT="$(ask_tty "Сколько Amnezia ключей генерить [100]: " || true)"
fi

if [ -z "$CLIENT_COUNT" ]; then
  CLIENT_COUNT="100"
fi

if ! [[ "$CLIENT_COUNT" =~ ^[0-9]+$ ]] || [ "$CLIENT_COUNT" -lt 1 ] || [ "$CLIENT_COUNT" -gt 253 ]; then
  echo "Количество Amnezia ключей должно быть числом от 1 до 253, получено: $CLIENT_COUNT" >&2
  exit 1
fi

printf -v LAST_CLIENT_ID "client-%03d" "$CLIENT_COUNT"
INSTALL_MTPROTO="$(normalize_yes_no "$INSTALL_MTPROTO" "Установить MTProto proxy для Telegram?")"
INSTALL_SOCKS5="$(normalize_yes_no "$INSTALL_SOCKS5" "Установить SOCKS5 proxy для Telegram?")"


  mapfile -t PUBLIC_IPS < <(python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["addresses"]))' <<<"$DISCOVERY")
  printf 'Публичные IPv4 в ОС: %s\n' "${PUBLIC_IPS[*]:-нет}"
  ADDITIONAL_IP="${VPN_ADDITIONAL_IPV4:-}"
  if [ -z "$ADDITIONAL_IP" ] && yes_no "$(ask_tty 'Есть дополнительный публичный IP, прикреплённый у хостера, но ещё не добавленный в ОС? [y/N] ' || true)"; then
    ADDITIONAL_IP="$(ask_tty 'Дополнительный публичный IPv4: ')"
  fi
  if [ -n "$ADDITIONAL_IP" ]; then
    validate_ipv4 "$ADDITIONAL_IP"
    python3 -c 'import ipaddress,sys; a=ipaddress.IPv4Address(sys.argv[1]); sys.exit(0 if a.is_global and not a.is_multicast else "IPv4 must be public unicast")' "$ADDITIONAL_IP"
    if [[ " ${PUBLIC_IPS[*]} " != *" $ADDITIONAL_IP "* ]]; then PUBLIC_IPS+=("$ADDITIONAL_IP"); fi
  fi
  if [ "${#PUBLIC_IPS[@]}" -eq 0 ]; then echo 'No public IPv4 configured; NAT-only hosts require manual configuration.' >&2; exit 1; fi
  ENTRY_IP="${VPN_ENTRY_IPV4:-$(state_value vpn_public_endpoint)}"
  EXIT_IP="${VPN_EXIT_IPV4:-$(state_value vpn_exit_ipv4)}"
  ENTRY_IP="${ENTRY_IP:-$SERVER_IP}"
  SPLIT="${VPN_SPLIT_IP:-}"
  if [ -z "$SPLIT" ] && [ -n "$EXIT_IP" ] && [ "$EXIT_IP" != "$ENTRY_IP" ]; then SPLIT=yes; fi
  if [ "${#PUBLIC_IPS[@]}" -ge 2 ]; then
    if [ -z "$SPLIT" ]; then SPLIT="$(ask_tty 'Использовать разные IP для входа и выхода VPN? [y/N] ' || true)"; fi
    if yes_no "$SPLIT"; then
      printf 'Доступные IPv4: %s\n' "${PUBLIC_IPS[*]}"
      if [ -z "${VPN_ENTRY_IPV4:-}" ]; then ENTRY_IP="$(ask_tty "Входной IPv4 [$ENTRY_IP]: " || true)"; ENTRY_IP="${ENTRY_IP:-$(state_value vpn_public_endpoint)}"; ENTRY_IP="${ENTRY_IP:-$SERVER_IP}"; fi
      if [ -z "${VPN_EXIT_IPV4:-}" ]; then
        DEFAULT_EXIT="$EXIT_IP"
        if [ -z "$DEFAULT_EXIT" ]; then for ip in "${PUBLIC_IPS[@]}"; do if [ "$ip" != "$ENTRY_IP" ]; then DEFAULT_EXIT="$ip"; break; fi; done; fi
        EXIT_IP="$(ask_tty "Выходной IPv4 [$DEFAULT_EXIT]: " || true)"; EXIT_IP="${EXIT_IP:-$DEFAULT_EXIT}"
      fi
      if [ "$ENTRY_IP" = "$EXIT_IP" ]; then echo 'Entry and exit must differ for split mode.' >&2; exit 1; fi
    else
      ENTRY_IP="$SERVER_IP"
      EXIT_IP=""
    fi
  else
    ENTRY_IP="${PUBLIC_IPS[0]}"
    EXIT_IP=""
  fi
  for ip in "$ENTRY_IP" ${EXIT_IP:+"$EXIT_IP"}; do
    validate_ipv4 "$ip"
    if [[ " ${PUBLIC_IPS[*]} " != *" $ip "* ]]; then echo "IPv4 is not available: $ip" >&2; exit 1; fi
  done
  DISABLE_IPV6="${VPN_DISABLE_IPV6:-$(state_value vpn_disable_ipv6)}"
  if [ -z "$DISABLE_IPV6" ]; then DISABLE_IPV6="$(ask_tty 'Отключить IPv6 для пользовательского VPN-трафика? [Y/n] ' || true)"; DISABLE_IPV6="${DISABLE_IPV6:-yes}"; fi
  DISABLE_IPV6="$(normalize_yes_no "$DISABLE_IPV6" '')"
  export ENTRY_IP EXIT_IP DISABLE_IPV6 ADDITIONAL_IP CLIENT_COUNT INSTALL_MTPROTO INSTALL_SOCKS5
  python3 - "$NETWORK_VARS_FILE" <<'PY'
import json, os, sys
data = dict(vpn_public_endpoint=os.environ['ENTRY_IP'], vpn_exit_ipv4=os.environ['EXIT_IP'],
            vpn_disable_ipv6=os.environ['DISABLE_IPV6']=='true', vpn_additional_ipv4=os.environ['ADDITIONAL_IP'],
            vpn_client_count=int(os.environ['CLIENT_COUNT']), install_mtproto=os.environ['INSTALL_MTPROTO']=='true',
            install_socks5=os.environ['INSTALL_SOCKS5']=='true')
with open(sys.argv[1], 'w') as stream: json.dump(data, stream)
PY
fi

write_inventory
chmod 600 "$INVENTORY_PATH"
if [ "$PHASE" = all ] || [ "$PHASE" = core ]; then
  echo '==> Фаза 1: VPN'
  "$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY_PATH" --limit "$TARGET" playbooks/vpn-core.yml -e "@$NETWORK_VARS_FILE"
  # Copy all client artifacts before asking about monitoring. Partial copies are never published.
  EXPORT_DIR="$PWD/exports/$SERVER_IP"
  mkdir -p "$EXPORT_DIR"
  chmod 700 "$PWD/exports" "$EXPORT_DIR"
  umask 077
  for name in amnezia-vpn-links.txt amneziawg-client-configs.txt client-links.txt xray-client-links.txt xray-experimental-client-links.txt xray-tun-client.json; do
    ssh "${SSH_ARGS[@]}" "root@$SERVER_IP" "cat /var/lib/vpn/$name" > "$EXPORT_DIR/$name.tmp"
    mv "$EXPORT_DIR/$name.tmp" "$EXPORT_DIR/$name"
  done
  if [ "$INSTALL_MTPROTO" = true ] || [ "$INSTALL_SOCKS5" = true ]; then
    ssh "${SSH_ARGS[@]}" "root@$SERVER_IP" 'cat /var/lib/vpn/telegram-proxy-links.txt' > "$EXPORT_DIR/telegram-proxy-links.txt"
  fi
  echo "VPN готов за $(format_duration "$(( $(date +%s) - DEPLOY_STARTED_AT ))"). Клиентские данные: $EXPORT_DIR"
  echo "Ссылки AmneziaVPN: $EXPORT_DIR/amnezia-vpn-links.txt"
  echo "На VPS: /var/lib/vpn/amnezia-vpn-links.txt"
  cat "$EXPORT_DIR/xray-client-links.txt" "$EXPORT_DIR/xray-experimental-client-links.txt"
  if [ -f "$EXPORT_DIR/telegram-proxy-links.txt" ]; then cat "$EXPORT_DIR/telegram-proxy-links.txt"; fi
  echo "Конфигурации AmneziaWG: $EXPORT_DIR/amneziawg-client-configs.txt"
  echo "Xray через TUN (sing-box, весь IPv4/IPv6 в VPN): $EXPORT_DIR/xray-tun-client.json"
fi

RUN_MONITORING=false
if [ "$PHASE" = monitoring ]; then RUN_MONITORING=true; fi
if [ "$PHASE" = all ]; then
  CONTINUE="${VPN_INSTALL_MONITORING:-}"
  if [ -z "$CONTINUE" ]; then CONTINUE="$(ask_tty 'VPN готов, ключи выданы. Продолжить установку мониторинга и дополнительных компонентов? [Y/n] ' || true)"; CONTINUE="${CONTINUE:-yes}"; fi
  if yes_no "$CONTINUE"; then RUN_MONITORING=true; fi
fi
if [ "$RUN_MONITORING" = true ]; then
  configure_monitoring
  write_inventory
  if [ -n "$MAIN_IP" ]; then add_known_host "$MAIN_IP"; fi
  if [ -n "$RESERVE_IP" ]; then add_known_host "$RESERVE_IP"; fi
if [ "$SERVER_ROLE" = "main" ]; then
  MONITORING_EXTRA_VARS_FILE="$(mktemp)"
  export TELEGRAM_ALERTS TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID GRAFANA_ADMIN_PASSWORD GRAFANA_BASIC_AUTH_PASSWORD ALERTMANAGER_BASIC_AUTH_PASSWORD GRAFANA_DEB_PATH
  python3 - "$MONITORING_EXTRA_VARS_FILE" <<'PY'
import json
import os
import sys

data = {
    "monitoring_preserve_grafana_auth": not bool(os.environ.get("VPN_GRAFANA_BASIC_AUTH_PASSWORD")),
    "monitoring_preserve_alertmanager_auth": not bool(os.environ.get("VPN_ALERTMANAGER_BASIC_AUTH_PASSWORD")),
    "monitoring_preserve_prometheus_auth": not bool(os.environ.get("VPN_GRAFANA_BASIC_AUTH_PASSWORD")),
    "monitoring_alertmanager_telegram_enabled": os.environ["TELEGRAM_ALERTS"] == "true",
    "monitoring_alertmanager_telegram_bot_token": os.environ.get("TELEGRAM_BOT_TOKEN", ""),
    "monitoring_alertmanager_telegram_chat_id": os.environ.get("TELEGRAM_CHAT_ID", ""),
    "monitoring_grafana_admin_password": os.environ.get("GRAFANA_ADMIN_PASSWORD", ""),
    "monitoring_grafana_basic_auth_password": os.environ.get("GRAFANA_BASIC_AUTH_PASSWORD", ""),
    "monitoring_alertmanager_basic_auth_password": os.environ.get("ALERTMANAGER_BASIC_AUTH_PASSWORD", ""),
    "monitoring_grafana_deb_path": os.environ.get("GRAFANA_DEB_PATH", ""),
}
with open(sys.argv[1], "w") as fh:
    json.dump(data, fh)
PY
  chmod 600 "$MONITORING_EXTRA_VARS_FILE"
  "$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY_PATH" playbooks/monitoring.yml -e "@$MONITORING_EXTRA_VARS_FILE"
  echo "Grafana: https://$SERVER_IP/ ; Alertmanager: https://$SERVER_IP:9443/ ; Prometheus: https://$SERVER_IP:9445/ (self-signed TLS, Basic Auth)"
else
  if [ -n "$MAIN_IP" ]; then
    "$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY_PATH" playbooks/connect-reserve-monitoring.yml
  else
    "$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY_PATH" playbooks/monitoring.yml
  fi
fi

fi
if [ "$PHASE" = exporter ]; then
  if [ -n "$MAIN_IP" ]; then add_known_host "$MAIN_IP"; fi
  "$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY_PATH" playbooks/xray-exporter.yml -e "xray_exporter_target=$TARGET"
fi
HARDEN="${VPN_DISABLE_SSH_PASSWORD:-}"
if [ -z "$HARDEN" ]; then HARDEN="$(ask_tty 'Отключить вход по SSH с паролем? [y/N] ' || true)"; fi
if yes_no "$HARDEN"; then bash scripts/ssh-harden "$INVENTORY_PATH" "$TARGET" "$SERVER_IP"; fi
echo "Готово. Время: $(format_duration "$(( $(date +%s) - DEPLOY_STARTED_AT ))")."
echo "Позднее: scripts/deploy-server --phase monitoring $SERVER_ROLE $SERVER_IP"
echo "Только Xray-exporter: scripts/deploy-server --phase exporter $SERVER_ROLE $SERVER_IP"
