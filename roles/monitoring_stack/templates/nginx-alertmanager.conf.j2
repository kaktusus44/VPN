server {
    listen {{ monitoring_alertmanager_external_port }} ssl;
    server_name {{ monitoring_alertmanager_external_server_name }};

    ssl_certificate {{ monitoring_grafana_tls_dir }}/grafana.crt;
    ssl_certificate_key {{ monitoring_grafana_tls_dir }}/grafana.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    auth_basic "Alertmanager";
    auth_basic_user_file {{ monitoring_alertmanager_htpasswd_path }};

    location / {
        proxy_pass http://{{ monitoring_alertmanager_listen_address }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
