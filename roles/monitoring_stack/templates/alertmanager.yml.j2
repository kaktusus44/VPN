global:
  resolve_timeout: 5m

route:
  receiver: {{ 'telegram' if monitoring_alertmanager_telegram_enabled | bool else 'null' }}
  group_by:
    - alertname
    - instance
    - provider
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 30m

receivers:
{% if monitoring_alertmanager_telegram_enabled | bool %}
  - name: telegram
    telegram_configs:
      - bot_token: {{ monitoring_alertmanager_telegram_bot_token | to_json }}
        chat_id: {{ monitoring_alertmanager_telegram_chat_id | int }}
        parse_mode: HTML
        message: '{{ "{{" }} template "telegram.default.message" . {{ "}}" }}'
{% else %}
  - name: null
{% endif %}

templates:
  - /etc/prometheus/alertmanager-templates/*.tmpl
