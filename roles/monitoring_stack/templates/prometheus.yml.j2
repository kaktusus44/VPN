global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - {{ monitoring_alertmanager_listen_address }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - {{ monitoring_prometheus_listen_address }}

  - job_name: node
    static_configs:
{% for host in groups['vpn_servers'] | default([]) %}
      - targets:
          - {{ '127.0.0.1' if host == inventory_hostname else (hostvars[host].vpn_public_endpoint | default(hostvars[host].ansible_host)) }}:9100
        labels:
          role: "{{ hostvars[host].vpn_server_role | default('unknown') }}"
          server: "{{ host }}"
{% endfor %}

  - job_name: vpn-custom-exporter
    static_configs:
{% for host in groups['vpn_servers'] | default([]) %}
      - targets:
          - {{ '127.0.0.1' if host == inventory_hostname else (hostvars[host].vpn_public_endpoint | default(hostvars[host].ansible_host)) }}:{{ hostvars[host].vpn_custom_exporter_port | default(vpn_custom_exporter_port | default(9187)) }}
        labels:
          role: "{{ hostvars[host].vpn_server_role | default('unknown') }}"
          server: "{{ host }}"
{% endfor %}
