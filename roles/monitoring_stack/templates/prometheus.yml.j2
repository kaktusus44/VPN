global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - {{ monitoring_alertmanager_listen_address }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - {{ monitoring_prometheus_listen_address }}

  - job_name: node
    static_configs:
      - targets:
          - 127.0.0.1:9100
        labels:
          role: {{ vpn_server_role }}

  - job_name: vpn-custom-exporter
    static_configs:
      - targets:
          - 127.0.0.1:{{ vpn_custom_exporter_port | default(9187) }}
        labels:
          role: {{ vpn_server_role }}
