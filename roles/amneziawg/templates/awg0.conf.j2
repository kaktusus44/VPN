#jinja2: trim_blocks: False
[Interface]
Address = {{ awg_ipv4_address }}{{ ', ' ~ awg_ipv6_address if vpn_enable_ipv6 | bool else '' }}
ListenPort = {{ awg_port }}
PrivateKey = {{ awg_server_private_key_raw.content | b64decode | trim }}
PostUp = iptables -t nat -A POSTROUTING -s {{ awg_ipv4_network }} -o {{ ansible_default_ipv4.interface }} -j {{ 'SNAT --to-source ' ~ vpn_exit_ipv4 if vpn_exit_ipv4 | default('') | length > 0 else 'MASQUERADE' }}
PostDown = iptables -t nat -D POSTROUTING -s {{ awg_ipv4_network }} -o {{ ansible_default_ipv4.interface }} -j {{ 'SNAT --to-source ' ~ vpn_exit_ipv4 if vpn_exit_ipv4 | default('') | length > 0 else 'MASQUERADE' }}

{% for client_key in awg_client_public_keys.results %}
[Peer]
# client-{{ '%03d' | format(loop.index) }}
PublicKey = {{ client_key.stdout }}
AllowedIPs = 10.8.0.{{ loop.index + 1 }}/32{{ ', fd00:8::' ~ (loop.index + 1) ~ '/128' if vpn_enable_ipv6 | bool or vpn_disable_ipv6 | default(false) | bool else '' }}

{% endfor %}
