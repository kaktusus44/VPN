#!/usr/bin/env python3
import base64
import json
from pathlib import Path
import secrets
import subprocess
import zlib


STATE_DIR = Path("/var/lib/vpn")
AWG_CONFIG = Path("{{ awg_config_dir }}/{{ awg_interface }}.conf")
SERVER_KEY = STATE_DIR / "{{ awg_interface }}.server.key"
PARAMS_FILE = STATE_DIR / "{{ awg_interface }}.obfuscation.json"
CLIENT_COUNT = {{ vpn_client_count | int }}
VPN_ROLE = "{{ vpn_server_role }}"
AWG_PORT = {{ awg_port | int }}
AWG_MTU = {{ awg_mtu | default(1280) | int }}
VPN_PUBLIC_ENDPOINT = "{{ vpn_public_endpoint }}"
ENDPOINT = "{{ vpn_public_endpoint }}:{{ awg_port }}"
EXT_IFACE = "{{ ansible_default_ipv4.interface }}"
ENABLE_IPV6 = {{ 'True' if vpn_enable_ipv6 | bool else 'False' }}
DNS_IPV4 = "{{ unbound_ipv4_listen }}"
DNS_IPV6 = "{{ unbound_ipv6_listen }}"
AMNEZIA_VPN_LINKS = Path("{{ export_amnezia_vpn_links_path }}")
AMNEZIAWG_CONFIGS = Path("{{ export_amneziawg_configs_path }}")
CLIENT_LINKS = Path("{{ export_client_links_path }}")
ENABLE_HEADER_PROTECTION = {{ 'True' if awg_enable_header_protection | bool else 'False' }}
ENABLE_CONTENT_PADDING = {{ 'True' if awg_enable_content_padding | bool else 'False' }}
ENABLE_TIMING_OBFUSCATION = {{ 'True' if awg_enable_timing_obfuscation | bool else 'False' }}
ENABLE_JUNK_PACKETS = {{ 'True' if awg_enable_junk_packets | default(false) | bool else 'False' }}


def run(args, stdin=None):
    result = subprocess.run(
        args,
        input=stdin,
        text=True,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    return result.stdout.strip()


def write_if_changed(path, content, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    old = path.read_text() if path.exists() else None
    if old != content:
        path.write_text(content)
        path.chmod(mode)
        return True
    path.chmod(mode)
    return False


def qcompress(raw):
    return len(raw).to_bytes(4, "big") + zlib.compress(raw)


def amnezia_vpn_link(config, client_private, client_public, address, server_public, allowed_ips, obfuscation):
    last_config = {
        "config": config,
        "hostName": VPN_PUBLIC_ENDPOINT,
        "port": AWG_PORT,
        "client_priv_key": client_private,
        "client_ip": address,
        "client_pub_key": client_public,
        "server_pub_key": server_public,
        "client_id": client_public,
        "allowed_ips": allowed_ips.split(", "),
        "persistent_keep_alive": "25",
        "mtu": str(AWG_MTU),
    }
    last_config.update(obfuscation)
    payload = {
        "dns1": DNS_IPV4,
        "dns2": DNS_IPV6 if ENABLE_IPV6 else "",
        "defaultContainer": "amnezia-awg",
        "description": f"{VPN_ROLE} AmneziaWG",
        "hostName": VPN_PUBLIC_ENDPOINT,
        "containers": [
            {
                "container": "amnezia-awg",
                "awg": {
                    "isThirdPartyConfig": True,
                    "last_config": json.dumps(last_config, separators=(",", ":")),
                    "port": str(AWG_PORT),
                    "transport_proto": "udp",
                },
            },
        ],
    }
    raw = json.dumps(payload, separators=(",", ":")).encode()
    return "vpn://" + base64.urlsafe_b64encode(qcompress(raw)).decode().rstrip("=")


def randint(low, high):
    return low + secrets.randbelow(high - low + 1)


def generate_h_ranges():
    for _ in range(100):
        points = sorted(randint(100000, 2_147_000_000) for _ in range(8))
        ranges = [f"{points[i]}-{points[i + 1]}" for i in range(0, 8, 2)]
        if len(set(ranges)) == 4:
            return ranges
    return [
        "234567-345678",
        "3456789-4567890",
        "56789012-67890123",
        "456789012-567890123",
    ]


def generate_obfuscation_params():
    jmin = randint(40, 89)
    s1 = randint(12, 32)
    s2 = randint(12, 32)
    while s1 + 56 == s2:
        s2 = randint(12, 32)
    if ENABLE_HEADER_PROTECTION:
        h1, h2, h3, h4 = "1", "2", "3", "4"
    else:
        h1, h2, h3, h4 = generate_h_ranges()

    params = {
        "Jc": str(randint(3, 6)),
        "Jmin": str(jmin),
        "Jmax": str(randint(jmin + 50, min(jmin + 250, 1280))),
        "S1": str(s1),
        "S2": str(s2),
        "S3": str(randint(12, 32)),
        "S4": str(randint(12, 27)),
        "H1": h1,
        "H2": h2,
        "H3": h3,
        "H4": h4,
    }
    if ENABLE_JUNK_PACKETS:
        params["I1"] = "<r 128>"
    if ENABLE_HEADER_PROTECTION:
        params["HeaderProtectionKey"] = run(["awg", "genkey"])
    if ENABLE_CONTENT_PADDING:
        params["ContentPaddingAddition"] = "0-32"
    if ENABLE_TIMING_OBFUSCATION:
        params.update(
            {
                "RekeyAfterTime": "110-130",
                "RekeyTimeout": "5-7",
                "RejectAfterTime": "170-190",
                "KeepaliveTimeout": "20-30",
                "MaxHandshakeAttempts": "5-8",
            }
        )
    return params


def load_obfuscation_params():
    params_changed = False
    if PARAMS_FILE.exists():
        params = json.loads(PARAMS_FILE.read_text())
    else:
        params = generate_obfuscation_params()
        params_changed = True
    if not ENABLE_HEADER_PROTECTION and params.pop("HeaderProtectionKey", None):
        params_changed = True
    if not ENABLE_CONTENT_PADDING and params.pop("ContentPaddingAddition", None):
        params_changed = True
    if not ENABLE_JUNK_PACKETS:
        for key in ("I1", "I2", "I3", "I4", "I5"):
            if params.pop(key, None):
                params_changed = True
    if not ENABLE_TIMING_OBFUSCATION:
        for key in (
            "RekeyAfterTime",
            "RekeyTimeout",
            "RejectAfterTime",
            "KeepaliveTimeout",
            "MaxHandshakeAttempts",
        ):
            if params.pop(key, None):
                params_changed = True
    if ENABLE_HEADER_PROTECTION and not params.get("HeaderProtectionKey"):
        params["HeaderProtectionKey"] = run(["awg", "genkey"])
        params_changed = True
    if ENABLE_CONTENT_PADDING and not params.get("ContentPaddingAddition"):
        params["ContentPaddingAddition"] = "0-32"
        params_changed = True
    if ENABLE_TIMING_OBFUSCATION:
        for key, value in {
            "RekeyAfterTime": "110-130",
            "RekeyTimeout": "5-7",
            "RejectAfterTime": "170-190",
            "KeepaliveTimeout": "20-30",
            "MaxHandshakeAttempts": "5-8",
        }.items():
            if not params.get(key):
                params[key] = value
                params_changed = True
    if ENABLE_HEADER_PROTECTION:
        for key, compatible_value in {
            "H1": "1",
            "H2": "2",
            "H3": "3",
            "H4": "4",
        }.items():
            if params.get(key) != compatible_value:
                params[key] = compatible_value
                params_changed = True
        for key in ("S1", "S2", "S3", "S4"):
            lower_bound = str(params.get(key, "0")).split("-", 1)[0]
            if int(lower_bound) < 12 or int(lower_bound) > 32:
                params[key] = "12"
                params_changed = True
    if params_changed:
        PARAMS_FILE.write_text(json.dumps(params, indent=2, sort_keys=True) + "\n")
        PARAMS_FILE.chmod(0o600)
    PARAMS_FILE.chmod(0o600)
    return params, params_changed


def obfuscation_lines(params):
    ordered_keys = [
        "Jc",
        "Jmin",
        "Jmax",
        "S1",
        "S2",
        "S3",
        "S4",
        "H1",
        "H2",
        "H3",
        "H4",
        "I1",
        "I2",
        "I3",
        "I4",
        "I5",
        "HeaderProtectionKey",
        "ContentPaddingAddition",
        "RekeyAfterTime",
        "RekeyTimeout",
        "RejectAfterTime",
        "KeepaliveTimeout",
        "MaxHandshakeAttempts",
    ]
    return [f"{key} = {params[key]}" for key in ordered_keys if params.get(key)]


changed = False
STATE_DIR.mkdir(parents=True, exist_ok=True)

server_private = SERVER_KEY.read_text().strip()
server_public = run(["awg", "pubkey"], stdin=server_private)
obfuscation, params_changed = load_obfuscation_params()
changed = changed or params_changed

server_lines = [
    "[Interface]",
    "Address = {{ awg_ipv4_address }}{{ ', ' ~ awg_ipv6_address if vpn_enable_ipv6 | bool else '' }}",
    "ListenPort = {{ awg_port }}",
    f"PrivateKey = {server_private}",
    *obfuscation_lines(obfuscation),
    "PostUp = iptables -t nat -A POSTROUTING -s {{ awg_ipv4_network }} -o " + EXT_IFACE + " -j MASQUERADE",
    "PostDown = iptables -t nat -D POSTROUTING -s {{ awg_ipv4_network }} -o " + EXT_IFACE + " -j MASQUERADE",
    "",
]

all_configs = []
vpn_links = []
client_index_lines = [
    f"amnezia_vpn_links {VPN_ROLE} {AMNEZIA_VPN_LINKS}",
    f"amneziawg_config_bundle {VPN_ROLE} {AMNEZIAWG_CONFIGS}",
]

for index in range(1, CLIENT_COUNT + 1):
    client_id = f"client-{index:03d}"
    client_key_path = STATE_DIR / f"{client_id}.key"
    if not client_key_path.exists():
        client_key_path.write_text(run(["awg", "genkey"]) + "\n")
        client_key_path.chmod(0o600)
        changed = True
    else:
        client_key_path.chmod(0o600)

    client_private = client_key_path.read_text().strip()
    client_public = run(["awg", "pubkey"], stdin=client_private)
    ipv4 = f"10.8.0.{index + 1}/32"
    ipv6 = f"fd00:8::{index + 1}/128"
    address = ipv4 + (f", {ipv6}" if ENABLE_IPV6 else "")
    dns = DNS_IPV4 + (f", {DNS_IPV6}" if ENABLE_IPV6 else "")
    allowed_ips = "0.0.0.0/0" + (", ::/0" if ENABLE_IPV6 else "")

    server_lines.extend(
        [
            "[Peer]",
            f"# {client_id}",
            f"PublicKey = {client_public}",
            f"AllowedIPs = {address}",
            "",
        ]
    )

    client_config = "\n".join(
        [
            "[Interface]",
            f"PrivateKey = {client_private}",
            f"Address = {address}",
            f"MTU = {AWG_MTU}",
            f"DNS = {dns}",
            *obfuscation_lines(obfuscation),
            "",
            "[Peer]",
            f"PublicKey = {server_public}",
            f"AllowedIPs = {allowed_ips}",
            f"Endpoint = {ENDPOINT}",
            "PersistentKeepalive = 25",
            "",
        ]
    )
    changed = write_if_changed(STATE_DIR / f"{client_id}.awg.conf", client_config) or changed
    all_configs.append(f"### {client_id} {VPN_ROLE} amneziawg_config\n{client_config}")
    vpn_links.append(
        f"{client_id} {VPN_ROLE} amnezia_vpn "
        f"{amnezia_vpn_link(client_config, client_private, client_public, address, server_public, allowed_ips, obfuscation)}"
    )
    client_index_lines.append(f"{client_id} {VPN_ROLE} amneziawg_config /var/lib/vpn/{client_id}.awg.conf")

changed = write_if_changed(AWG_CONFIG, "\n".join(server_lines), mode=0o600) or changed
changed = write_if_changed(AMNEZIAWG_CONFIGS, "\n".join(all_configs) + "\n", mode=0o600) or changed
changed = write_if_changed(AMNEZIA_VPN_LINKS, "\n".join(vpn_links) + "\n", mode=0o600) or changed
xray_block = ""
if CLIENT_LINKS.exists():
    existing_client_links = CLIENT_LINKS.read_text()
    marker_index = existing_client_links.find("# BEGIN XRAY CLIENT LINKS")
    if marker_index >= 0:
        xray_block = "\n" + existing_client_links[marker_index:].strip() + "\n"
changed = write_if_changed(CLIENT_LINKS, "\n".join(client_index_lines) + "\n" + xray_block, mode=0o600) or changed

print(f"changed={'true' if changed else 'false'} clients={CLIENT_COUNT} vpn_links={AMNEZIA_VPN_LINKS}")
