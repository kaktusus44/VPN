logoutput: syslog
internal: 0.0.0.0 port = {{ socks5_port }}
external: {{ ansible_default_ipv4.interface }}
socksmethod: username
clientmethod: none
user.privileged: root
user.unprivileged: nobody

client pass {
  from: 0.0.0.0/0 to: 0.0.0.0/0
  log: connect error
}

socks pass {
  from: 0.0.0.0/0 to: 0.0.0.0/0
  command: connect bind udpassociate
  socksmethod: username
  log: connect error
}
