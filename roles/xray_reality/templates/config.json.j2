#jinja2: trim_blocks: False
{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "vless-xhttp-reality",
      "listen": "0.0.0.0",
      "port": {{ xray_xhttp_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ xray_client_uuid }}"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ xray_reality_dest }}",
          "serverNames": [
            "{{ xray_reality_server_name }}"
          ],
          "privateKey": "{{ xray_reality_private_key }}",
          "shortIds": [
            "{{ xray_reality_short_id }}"
          ]
        }
      }
    },
    {
      "tag": "vless-tcp-reality",
      "listen": "0.0.0.0",
      "port": {{ xray_tcp_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ xray_client_uuid }}",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ xray_reality_dest }}",
          "serverNames": [
            "{{ xray_reality_server_name }}"
          ],
          "privateKey": "{{ xray_reality_private_key }}",
          "shortIds": [
            "{{ xray_reality_short_id }}"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    }
  ]
}
