#jinja2: trim_blocks: False
{
  "log": {
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log",
    "loglevel": "info"
  },
{% if vpn_disable_ipv6 | default(false) | bool or vpn_exit_ipv4 | default('') | length > 0 %}
  "dns": {
    "servers": ["1.1.1.1", "8.8.8.8"],
    "queryStrategy": "UseIPv4",
    "tag": "vpn-dns"
  },
{% endif %}
  "inbounds": [
    {
      "tag": "vless-xhttp-reality",
      "listen": "0.0.0.0",
      "port": {{ xray_xhttp_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ xray_client_uuid }}"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ xray_reality_dest }}",
          "serverNames": [
            "{{ xray_reality_server_name }}"
          ],
          "privateKey": "{{ xray_reality_private_key }}",
          "shortIds": [
            "{{ xray_reality_short_id }}"
          ]
        }
      }
    },
    {
      "tag": "vless-tcp-reality",
      "listen": "0.0.0.0",
      "port": {{ xray_tcp_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ xray_client_uuid }}",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ xray_reality_dest }}",
          "serverNames": [
            "{{ xray_reality_server_name }}"
          ],
          "privateKey": "{{ xray_reality_private_key }}",
          "shortIds": [
            "{{ xray_reality_short_id }}"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct",
{% if vpn_exit_ipv4 | default('') | length > 0 %}
      "sendThrough": "{{ vpn_exit_ipv4 }}",
{% endif %}
      "settings": {
        "domainStrategy": "{{ 'ForceIPv4' if vpn_disable_ipv6 | default(false) | bool else 'UseIPv4' }}"
      }
    }{% if vpn_disable_ipv6 | default(false) | bool %},
    {"protocol": "blackhole", "tag": "block-ipv6"}
{% endif %}
  ]{% if vpn_disable_ipv6 | default(false) | bool %},
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [{"type": "field", "ip": ["::/0"], "outboundTag": "block-ipv6"}]
  }
{% endif %}
}
