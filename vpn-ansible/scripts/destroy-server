#!/usr/bin/env bash
set -Eeuo pipefail

ARG1="${1:-}"
ARG2="${2:-}"
SERVER_ROLE=""
SERVER_IP=""

ask_tty() {
  local prompt="$1"
  local answer
  if [ ! -r /dev/tty ]; then
    return 1
  fi
  read -r -p "$prompt" answer </dev/tty
  printf '%s' "$answer"
}

if [[ "$ARG1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
  SERVER_IP="$ARG1"
  SERVER_ROLE="$ARG2"
else
  SERVER_ROLE="$ARG1"
  SERVER_IP="$ARG2"
fi

if [ -z "$SERVER_ROLE" ]; then
  SERVER_ROLE="$(ask_tty "Какой сервер удаляем [main/reserve]: " || true)"
fi

case "$SERVER_ROLE" in
  main|reserve) ;;
  "")
    SERVER_ROLE="main"
    ;;
  *)
    echo "Роль должна быть main или reserve, получено: $SERVER_ROLE" >&2
    exit 1
    ;;
esac

if [ -z "$SERVER_IP" ]; then
  SERVER_IP="$(ask_tty "IP сервера: " || true)"
fi

if [ -z "$SERVER_IP" ]; then
  echo "IP сервера обязателен." >&2
  echo "Использование: scripts/destroy-server [main|reserve] <ip-сервера>" >&2
  echo "Также можно: scripts/destroy-server <ip-сервера> [main|reserve]" >&2
  exit 1
fi

if ! [[ "$SERVER_IP" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
  echo "Ожидался IPv4-адрес, получено: $SERVER_IP" >&2
  exit 1
fi

cd "$(dirname "$0")/.."

ANSIBLE_PLAYBOOK_BIN="$PWD/.venv/bin/ansible-playbook"
INVENTORY_PATH="$PWD/inventories/test/hosts.yml"

if [ ! -x "$ANSIBLE_PLAYBOOK_BIN" ]; then
  echo "Совместимая версия Ansible не установлена." >&2
  echo "Сначала запустите: VPN_DIR=\"$PWD\" bash scripts/bootstrap-ubuntu-control" >&2
  exit 1
fi

cat > "$INVENTORY_PATH" <<EOF
---
all:
  children:
    vpn_servers:
      hosts:
        vpn-test-1:
          ansible_host: $SERVER_IP
          ansible_user: root
          ansible_port: 22
          vpn_server_role: $SERVER_ROLE
          vpn_public_endpoint: $SERVER_IP
EOF

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

if ! ssh-keygen -F "$SERVER_IP" >/dev/null 2>&1; then
  echo "Добавляю SSH host key для $SERVER_IP"
  ssh-keyscan -T 5 -H "$SERVER_IP" >> "$HOME/.ssh/known_hosts"
fi

cat <<EOF
===== VPN DESTROY =====
Сервер:
  роль: $SERVER_ROLE
  IP: $SERVER_IP

Что будет удалено:
  управляемые VPN services/configs/packages
  /var/lib/vpn

Что НЕ будет удалено:
  SSH server
  /root/.ssh/authorized_keys
  локальный приватный ключ Ansible
===== КОНЕЦ ПРЕДУПРЕЖДЕНИЯ =====
EOF

if [ "${VPN_RESET_CONFIRM:-}" != "DESTROY" ]; then
  if [ ! -r /dev/tty ]; then
    echo "Для destroy задайте VPN_RESET_CONFIRM=DESTROY." >&2
    exit 1
  fi

  read -r -p "Введите DESTROY для удаления VPN-стека: " RESET_CONFIRM </dev/tty
  if [ "$RESET_CONFIRM" != "DESTROY" ]; then
    echo "Отменено: подтверждение не совпало." >&2
    exit 1
  fi
fi

"$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY_PATH" playbooks/reset-vpn.yml -e vpn_reset_confirm=DESTROY

cat <<EOF

===== ИТОГ DESTROY =====
Сервер:
  роль: $SERVER_ROLE
  IP: $SERVER_IP

Destroy завершён.
SSH-доступ сохранён.
===== КОНЕЦ ИТОГА =====
EOF
