#!/usr/bin/env bash
set -Eeuo pipefail

SERVER_IP="${1:-}"
SERVER_ROLE="${2:-}"

if [ -z "$SERVER_IP" ]; then
  echo "Использование: scripts/check-server <ip-сервера> [main|reserve]" >&2
  echo "Пример: scripts/check-server 108.165.33.37 reserve" >&2
  exit 1
fi

if ! [[ "$SERVER_IP" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
  echo "Ожидался IPv4-адрес, получено: $SERVER_IP" >&2
  exit 1
fi

if [ -z "$SERVER_ROLE" ]; then
  if [ -r /dev/tty ]; then
    echo "Какой сервер проверяем?"
    echo "1) main"
    echo "2) reserve"
    read -r -p "Введите 1 или 2: " ROLE_CHOICE </dev/tty
    case "$ROLE_CHOICE" in
      1|main) SERVER_ROLE="main" ;;
      2|reserve|"") SERVER_ROLE="reserve" ;;
      *)
        echo "Ожидалось 1/main или 2/reserve." >&2
        exit 1
        ;;
    esac
  else
    SERVER_ROLE="reserve"
  fi
fi

case "$SERVER_ROLE" in
  main|reserve) ;;
  *)
    echo "Роль должна быть main или reserve, получено: $SERVER_ROLE" >&2
    exit 1
    ;;
esac

cd "$(dirname "$0")/.."

ANSIBLE_BIN="$PWD/.venv/bin/ansible"
ANSIBLE_PLAYBOOK_BIN="$PWD/.venv/bin/ansible-playbook"
SSH_KEY_PATH="${VPN_SSH_KEY:-$HOME/.ssh/vpn_ansible}"
INVENTORY_PATH="$PWD/inventories/test/hosts.yml"

if [ ! -x "$ANSIBLE_BIN" ] || [ ! -x "$ANSIBLE_PLAYBOOK_BIN" ]; then
  echo "Совместимая версия Ansible не установлена." >&2
  echo "Сначала запустите: VPN_DIR=\"$PWD\" bash scripts/bootstrap-ubuntu-control" >&2
  exit 1
fi

cat > "$INVENTORY_PATH" <<EOF
---
all:
  children:
    vpn_servers:
      hosts:
        vpn-test-1:
          ansible_host: $SERVER_IP
          ansible_user: root
          ansible_port: 22
          vpn_server_role: $SERVER_ROLE
          vpn_public_endpoint: $SERVER_IP
EOF

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

if ! ssh-keygen -F "$SERVER_IP" >/dev/null 2>&1; then
  echo "Добавляю SSH host key для $SERVER_IP"
  ssh-keyscan -T 5 -H "$SERVER_IP" >> "$HOME/.ssh/known_hosts"
fi

echo
echo "Проверяю SSH/Ansible-доступ к $SERVER_IP ($SERVER_ROLE)"
"$ANSIBLE_BIN" --version | head -n 1
"$ANSIBLE_BIN" -i inventories/test/hosts.yml all -m ping

echo
echo "Запускаю read-only preflight сервера"
"$ANSIBLE_PLAYBOOK_BIN" -i inventories/test/hosts.yml playbooks/preflight.yml

echo
cat <<EOF
===== ИТОГ ПРОВЕРКИ СЕРВЕРА =====
Сервер:
  роль: $SERVER_ROLE
  IP: $SERVER_IP
  Ansible host alias: vpn-test-1

Локальные пути:
  репозиторий: $PWD
  inventory: $INVENTORY_PATH
  приватный SSH-ключ: $SSH_KEY_PATH
  публичный SSH-ключ: $SSH_KEY_PATH.pub
  known_hosts: $HOME/.ssh/known_hosts
  Ansible binary: $ANSIBLE_BIN
  Ansible playbook binary: $ANSIBLE_PLAYBOOK_BIN

Что поставилось этим check-server:
  на управляющей машине: ничего, используется готовая .venv
  на VPS: ничего, preflight read-only

Что могло измениться до проверки:
  публичный ключ Ansible должен быть в /root/.ssh/authorized_keys на VPS
  SSH host key сервера мог быть добавлен в $HOME/.ssh/known_hosts

Что проверено на VPS:
  SSH/Ansible ping: SUCCESS/pong
  hostnamectl: идентичность и ОС сервера
  ss -ltnup: слушающие TCP/UDP порты
  ufw status verbose: статус firewall
  systemctl: статусы сервисов amnezia/awg/wireguard/xray/unbound/nginx/fail2ban/ssh/ufw/exporter

Если ошибок нет, отправьте этот вывод инженеру.
===== КОНЕЦ ИТОГА =====
EOF
