#!/usr/bin/env bash
set -Eeuo pipefail

SERVER_IP="${1:-}"

if [ -z "$SERVER_IP" ]; then
  echo "Использование: scripts/check-server <ip-сервера>" >&2
  echo "Пример: scripts/check-server 108.165.33.37" >&2
  exit 1
fi

if ! [[ "$SERVER_IP" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
  echo "Ожидался IPv4-адрес, получено: $SERVER_IP" >&2
  exit 1
fi

cd "$(dirname "$0")/.."

cat > inventories/test/hosts.yml <<EOF
---
all:
  children:
    vpn_servers:
      hosts:
        vpn-test-1:
          ansible_host: $SERVER_IP
          ansible_user: root
          ansible_port: 22
          vpn_server_role: reserve
          vpn_public_endpoint: $SERVER_IP
EOF

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

if ! ssh-keygen -F "$SERVER_IP" >/dev/null 2>&1; then
  echo "Добавляю SSH host key для $SERVER_IP"
  ssh-keyscan -T 5 -H "$SERVER_IP" >> "$HOME/.ssh/known_hosts"
fi

echo
echo "Проверяю SSH/Ansible-доступ к $SERVER_IP"
ansible -i inventories/test/hosts.yml all -m ping

echo
echo "Запускаю read-only preflight сервера"
ansible-playbook -i inventories/test/hosts.yml playbooks/preflight.yml

echo
echo "Готово. Если ошибок нет, отправьте этот вывод инженеру."
