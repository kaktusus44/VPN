#!/usr/bin/env bash
set -Eeuo pipefail

REPO_URL="${VPN_REPO_URL:-https://github.com/kaktusus44/VPN.git}"
INSTALL_DIR="${VPN_DIR:-$HOME/VPN}"
SSH_KEY_PATH="${VPN_SSH_KEY:-$HOME/.ssh/vpn_ansible}"

log() {
  printf '\n==> %s\n' "$*"
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1
}

if need_cmd sudo; then
  SUDO=sudo
else
  SUDO=
fi

if ! need_cmd apt-get; then
  echo "Этот bootstrap-скрипт поддерживает Ubuntu/Debian с apt-get." >&2
  exit 1
fi

log "Устанавливаю программы на управляющую Ubuntu"
$SUDO apt-get update
$SUDO DEBIAN_FRONTEND=noninteractive apt-get install -y \
  ansible \
  git \
  openssh-client \
  python3

log "Готовлю SSH-ключ для Ansible"
mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

if [ -f "$SSH_KEY_PATH" ]; then
  echo "Использую существующий ключ: $SSH_KEY_PATH"
else
  ssh-keygen -t ed25519 -N "" -f "$SSH_KEY_PATH" -C "vpn-ansible-$(hostname)-$(date +%Y%m%d)"
fi
chmod 600 "$SSH_KEY_PATH"
chmod 644 "$SSH_KEY_PATH.pub"

if [ -d "$INSTALL_DIR/.git" ]; then
  log "Обновляю существующий репозиторий: $INSTALL_DIR"
  git -C "$INSTALL_DIR" pull --ff-only
elif [ -e "$INSTALL_DIR" ]; then
  echo "$INSTALL_DIR уже существует, но это не git-репозиторий." >&2
  echo "Переместите эту папку или запустите с VPN_DIR=/another/path." >&2
  exit 1
else
  log "Скачиваю VPN-репозиторий"
  git clone "$REPO_URL" "$INSTALL_DIR"
fi

cd "$INSTALL_DIR"

log "Устанавливаю Ansible collections"
ansible-galaxy collection install -r requirements.yml

log "Управляющая Ubuntu готова"
cat <<EOF

Репозиторий:
  $INSTALL_DIR

Публичный SSH-ключ. Добавьте его у VPS-провайдера при создании сервера:
$(cat "$SSH_KEY_PATH.pub")

Проверка нового сервера:
  cd "$INSTALL_DIR"
  scripts/check-server 1.2.3.4

Замените 1.2.3.4 на IP сервера.
Не запускайте playbooks/vpn-core.yml без подтверждения инженера.
EOF
