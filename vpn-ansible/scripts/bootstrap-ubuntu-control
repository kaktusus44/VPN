#!/usr/bin/env bash
set -Eeuo pipefail

REPO_URL="${VPN_REPO_URL:-https://github.com/kaktusus44/VPN.git}"
INSTALL_DIR="${VPN_DIR:-$HOME/VPN}"
SSH_KEY_PATH="${VPN_SSH_KEY:-$HOME/.ssh/vpn_ansible}"

log() {
  printf '\n==> [%s] %s\n' "$(date +%H:%M:%S)" "$*"
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1
}

if need_cmd sudo; then
  SUDO=sudo
else
  SUDO=
fi

wait_for_apt() {
  local waited=0
  while fuser /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/cache/apt/archives/lock >/dev/null 2>&1; do
    if [ "$waited" -eq 0 ]; then
      log "Жду, пока Ubuntu закончит фоновое обновление apt"
    fi
    echo "apt занят другим процессом, жду 10 секунд..."
    sleep 10
    waited=$((waited + 10))
  done
}

ask_tty() {
  local prompt="$1"
  local answer
  if [ ! -r /dev/tty ]; then
    return 1
  fi
  read -r -p "$prompt" answer </dev/tty
  printf '%s' "$answer"
}

if ! need_cmd apt-get; then
  echo "Этот bootstrap-скрипт поддерживает Ubuntu/Debian с apt-get." >&2
  exit 1
fi

if [ -n "$SUDO" ]; then
  log "Проверяю sudo-доступ"
  $SUDO -v
fi

log "Устанавливаю программы на управляющую Ubuntu"
wait_for_apt
$SUDO apt-get update || echo "apt update завершился с предупреждением. Продолжаю установку по доступным индексам."
wait_for_apt
$SUDO DEBIAN_FRONTEND=noninteractive apt-get install -y \
  ansible \
  git \
  openssh-client \
  python3

log "Готовлю SSH-ключ для Ansible"
mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

if [ -f "$SSH_KEY_PATH" ]; then
  echo "Использую существующий ключ: $SSH_KEY_PATH"
else
  ssh-keygen -t ed25519 -N "" -f "$SSH_KEY_PATH" -C "vpn-ansible-$(hostname)-$(date +%Y%m%d)"
fi
chmod 600 "$SSH_KEY_PATH"
chmod 644 "$SSH_KEY_PATH.pub"

if [ -d "$INSTALL_DIR/.git" ]; then
  log "Обновляю существующий репозиторий: $INSTALL_DIR"
  git -C "$INSTALL_DIR" pull --ff-only
elif [ -e "$INSTALL_DIR" ]; then
  echo "$INSTALL_DIR уже существует, но это не git-репозиторий." >&2
  echo "Переместите эту папку или запустите с VPN_DIR=/another/path." >&2
  exit 1
else
  log "Скачиваю VPN-репозиторий"
  git clone "$REPO_URL" "$INSTALL_DIR"
fi

cd "$INSTALL_DIR"

log "Устанавливаю Ansible collections"
ansible-galaxy collection install -r requirements.yml

log "Управляющая Ubuntu готова"
cat <<EOF

Репозиторий:
  $INSTALL_DIR

Публичный SSH-ключ. Добавьте его у VPS-провайдера при создании сервера:
$(cat "$SSH_KEY_PATH.pub")

Когда сервер создан, проверка запускается так:
  cd "$INSTALL_DIR"
  scripts/check-server 1.2.3.4 main

Замените 1.2.3.4 на IP сервера.
Роль укажите main или reserve.
Не запускайте playbooks/vpn-core.yml без подтверждения инженера.
EOF

if [ -r /dev/tty ]; then
  echo
  CONTINUE_NOW="$(ask_tty "Сервер уже создан и SSH-ключ добавлен? Проверить сейчас? [y/N]: " || true)"
  case "$CONTINUE_NOW" in
    y|Y|yes|YES|да|Да|ДА)
      SERVER_IP="$(ask_tty "IP сервера: ")"
      SERVER_ROLE="$(ask_tty "Роль сервера [main/reserve, Enter=reserve]: ")"
      SERVER_ROLE="${SERVER_ROLE:-reserve}"
      "$INSTALL_DIR/scripts/check-server" "$SERVER_IP" "$SERVER_ROLE"
      ;;
    *)
      echo "Ок. Когда сервер будет готов, запустите: cd \"$INSTALL_DIR\" && scripts/check-server <IP> <main|reserve>"
      ;;
  esac
fi
